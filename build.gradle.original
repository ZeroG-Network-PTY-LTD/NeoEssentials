// Root project build file
buildscript {
    repositories {
        mavenCentral()
        maven { url = 'https://maven.neoforged.net/releases' }
        maven { url = 'https://maven.minecraftforge.net/' }
    }
}

// Apply plugins to all subprojects
allprojects {
    apply plugin: 'java-library'
    
    group = 'com.zerog.neoessentials'
    version = '1.0.0'
    
    java {
        toolchain.languageVersion = JavaLanguageVersion.of(17) // Base Java version
    }
    
    repositories {
        mavenCentral()
        maven { url = 'https://maven.neoforged.net/releases' }
        maven { url = 'https://maven.minecraftforge.net/' }
        maven { url = 'https://repo.lucko.me/' } // For LuckPerms API
    }
}

// Common configuration for all subprojects
subprojects {
    apply plugin: 'maven-publish'
    
    tasks.withType(JavaCompile).configureEach {
        options.encoding = 'UTF-8'
    }
    
    // Database dependencies shared across all versions
    dependencies {
        implementation 'org.xerial:sqlite-jdbc:3.44.1.0'
        implementation 'com.mysql:mysql-connector-j:8.2.0'
        
        // LuckPerms API dependencies (soft dependency, only for permission checking)
        compileOnly 'net.luckperms:api:5.4'
    }
    
    // Publishing configuration
    publishing {
        publications {
            mavenJava(MavenPublication) {
                from components.java
            }
        }
        repositories {
            maven {
                url "file://${rootProject.projectDir}/repo"
            }
        }
    }
}

// Define a task to increment the build number
tasks.register('incrementBuildNumber') {
    description = 'Increments the build number for all projects'
    
    doLast {
        def propsFile = file("buildnumber.properties")
        def props = new Properties()
        
        if (propsFile.exists()) {
            propsFile.withInputStream { props.load(it) }
        }
        
        def currentBuildNumber = props.getProperty("buildNumber", "0").toInteger() + 1
        props.setProperty("buildNumber", currentBuildNumber.toString())
        
        propsFile.withOutputStream { 
            props.store(it, "Build number updated") 
        }
        
        println "Build number incremented to: ${currentBuildNumber}"
    }
}

// Task to build all versions
tasks.register('buildAll') {
    description = 'Builds all versions of the mod'
    
    dependsOn subprojects.collect { it.tasks.withType(Jar) }
    
    finalizedBy tasks.incrementBuildNumber
}

// Task to publish all versions
tasks.register('publishAll') {
    description = 'Publishes all versions of the mod'
    
    dependsOn subprojects.collect { it.tasks.withType(PublishToMavenRepository) }
    
    finalizedBy tasks.incrementBuildNumber
}
