#Tablist System Settings
[tablist]
	#How often to update the tablist (in milliseconds)
	# Default: 2000
	# Range: 500 ~ 30000
	updateInterval = 2000
	#Time format for %time% placeholder (Java DateTimeFormatter syntax)
	timeFormat = "HH:mm:ss"
	#Enable sorting of players in the tablist
	enableSorting = true
	#Sort type (name, rank, playtime)
	sortType = "name"
	#Show players' economy balances in tablist
	showEconomyInTablist = true
	#Allow per-player custom headers based on permissions
	enablePlayerSpecificHeaders = true
	#Allow per-player custom footers based on permissions
	enablePlayerSpecificFooters = true

#Header and Footer Templates
[templates]
	#List of header lines to display in rotation (supports placeholders like %server%, %online%, %time%)
	headers = ["&6&l✦ &b&lNeoEssentials Server &6&l✦", "&eWelcome, &a%player%&e!", "&eOnline players: &a%online%/%max%", "&eServer time: &a%time%"]
	#List of footer lines to display in rotation (supports placeholders like %server%, %online%, %time%)
	footers = ["&eBalance: &a%balance% coins", "&eWebsite: &awww.example.com", "&eThanks for playing!", "&eRunning &aNeoForge %neoforge%"]
