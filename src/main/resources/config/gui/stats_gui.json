{
  "player_stats_gui": {
    "enabled": true,
    "title": "§b§lPlayer Statistics",
    "size": 54,
    "theme": "default",
    "auto_refresh": true,
    "refresh_interval": 10
  },
  "layout": {
    "title": "§b§lPlayer Statistics - {player_name}",
    "size": 54,
    "slots": {
      "0-8": {
        "type": "border",
        "item": "minecraft:blue_stained_glass_pane",
        "name": " ",
        "action": "none"
      },
      "9": {
        "type": "stat",
        "item": "minecraft:player_head",
        "name": "§6👤 Player Information",
        "lore": [
          "§7Name: §f{player_name}",
          "§7UUID: §f{player_uuid_short}",
          "§7First Join: §f{first_join}",
          "§7Last Seen: §f{last_seen}",
          "§7Playtime: §f{total_playtime}",
          "§7Current Session: §f{session_time}"
        ],
        "action": "none"
      },
      "10": {
        "type": "stat",
        "item": "minecraft:emerald",
        "name": "§a💰 Economy Statistics",
        "lore": [
          "§7Current Balance: §2{balance}",
          "§7Total Earned: §2{total_earned}",
          "§7Total Spent: §c{total_spent}",
          "§7Net Worth: §6{net_worth}",
          "§7Transactions: §f{transaction_count}",
          "§7Economy Rank: §e{economy_rank}"
        ],
        "action": "show_detailed_economy"
      },
      "11": {
        "type": "stat",
        "item": "minecraft:diamond_sword",
        "name": "§c⚔ Combat Statistics",
        "lore": [
          "§7Player Kills: §c{player_kills}",
          "§7Mob Kills: §c{mob_kills}",
          "§7Deaths: §c{deaths}",
          "§7K/D Ratio: §c{kd_ratio}",
          "§7Damage Dealt: §c{damage_dealt}",
          "§7Damage Taken: §c{damage_taken}"
        ],
        "action": "show_detailed_combat"
      },
      "12": {
        "type": "stat",
        "item": "minecraft:diamond_pickaxe",
        "name": "§8⛏ Mining Statistics",
        "lore": [
          "§7Blocks Mined: §8{blocks_mined}",
          "§7Ores Found: §8{ores_found}",
          "§7Distance Mined: §8{distance_mined}m",
          "§7Tools Broken: §8{tools_broken}",
          "§7Favorite Tool: §8{favorite_tool}",
          "§7Mining Level: §8{mining_level}"
