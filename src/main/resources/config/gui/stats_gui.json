        "lore": [
          "§7Latest achievements:",
          "§a• {recent_achievement_1}",
          "§a• {recent_achievement_2}",
          "§a• {recent_achievement_3}",
          "",
          "§eClick to view all achievements!"
        ],
        "action": "show_achievements"
      },
      "28": {
        "type": "ranking",
        "item": "minecraft:gold_ingot",
        "name": "§e🥇 Server Rankings",
        "lore": [
          "§7Your server rankings:",
          "§7Playtime: §e#{playtime_rank}",
          "§7Economy: §e#{economy_rank}",
          "§7Combat: §e#{combat_rank}",
          "§7Mining: §e#{mining_rank}",
          "",
          "§eClick to view leaderboards!"
        ],
        "action": "show_leaderboards"
      },
      "29": {
        "type": "social",
        "item": "minecraft:player_head",
        "name": "§d👥 Social Statistics",
        "lore": [
          "§7Friends Online: §d{friends_online}",
          "§7Messages Sent: §d{messages_sent}",
          "§7Commands Used: §d{commands_used}",
          "§7Votes Cast: §d{votes_cast}",
          "§7Reputation: §d{reputation}",
          "",
          "§eClick for social details!"
        ],
        "action": "show_social"
      },
      "30-35": {
        "type": "empty",
        "action": "none"
      },
      "36": {
        "type": "function",
        "item": "minecraft:clock",
        "name": "§6⏱ Session Information",
        "lore": [
          "§7Session Start: §f{session_start}",
          "§7Session Duration: §f{session_duration}",
          "§7Session XP Gained: §a{session_xp}",
          "§7Session Money Earned: §2{session_money}",
          "§7Session Blocks Mined: §8{session_blocks}",
          "",
          "§7Real-time session tracking!"
        ],
        "action": "none"
      },
      "37": {
        "type": "function",
        "item": "minecraft:writable_book",
        "name": "§6📊 Export Statistics",
        "lore": [
          "§7Export your statistics",
          "§7Generate detailed report",
          "§7Share with friends",
          "",
          "§eClick to export!"
        ],
        "action": "export_stats"
      },
      "38": {
        "type": "function",
        "item": "minecraft:comparator",
        "name": "§6⚙ Statistics Settings",
        "lore": [
          "§7Configure statistics tracking",
          "§7Privacy settings",
          "§7Display preferences",
          "",
          "§eClick to configure!"
        ],
        "action": "stats_settings"
      },
      "39-43": {
        "type": "empty",
        "action": "none"
      },
      "44": {
        "type": "close",
        "item": "minecraft:barrier",
        "name": "§c✖ Close Statistics",
        "lore": [
          "§7Close statistics interface",
          "",
          "§cClick to close!"
        ],
        "action": "close_gui"
      },
      "45-53": {
        "type": "border",
        "item": "minecraft:blue_stained_glass_pane",
        "name": " ",
        "action": "none"
      }
