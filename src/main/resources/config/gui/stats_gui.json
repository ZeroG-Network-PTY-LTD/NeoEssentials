          "§7Items Dropped: §7{items_dropped}",
          "§7Inventory Full: §7{inventory_full_count}x",
          "§7Chests Opened: §7{chests_opened}",
          "§7Items Traded: §7{items_traded}",
          "§7Collector Level: §7{collector_level}"
        ],
        "action": "show_detailed_inventory"
      },
      "18-26": {
        "type": "border",
        "item": "minecraft:blue_stained_glass_pane",
        "name": " ",
        "action": "none"
      },
      "27": {
        "type": "achievement",
        "item": "minecraft:golden_apple",
