{
  "_configVersion": 3,
  "_configVersion_comment": "DO NOT MODIFY: This field is used by NeoEssentials for automatic config updates. Changing this may cause config corruption.",
  "modules": {
    "economyEnabled": true,
    "commandsEnabled": true,
    "permissionsEnabled": true,
    "debugMode": false
  },
  "economySettings": {
    "startingBalance": 100.0,
    "currencySymbol": "$",
    "maxBalance": 999999999.99,
    "cleanupInactiveAccounts": true,
    "taxPercentage": 0.0,
    "maxTransferAmount": 100000.0,
    "paytoggleDefault": true,
    "allowNegativeBalances": false,
    "inactiveAccountCleanupDays": 30,
    "cacheMaximumSize": 10000,
    "cacheExpireAfterAccessMinutes": 60
  },
  "commands": {
    "balance": true,
    "pay": true,
    "paytoggle": true,
    "eco": true,
    "baltop": true,
    "repair": true,
    "dispose": true,
    "powertool": true,
    "powertooltoggle": true,
    "clearinventory": true,
    "enchant": true,
    "enchanthand": true,
    "msg": true,
    "reply": true,
    "afk": true,
    "ignore": true,
    "unignore": true,
    "mute": true,
    "unmute": true,
    "msgtoggle": true,
    "socialspy": true,
    "permissions": true
  },
  "security": {
    "enableInputValidation": true,
    "maxCommandLength": 256,
    "maxReasonLength": 500,
    "allowUnsafeCommands": false,
    "enablePathTraversalProtection": true,
    "enableXSSProtection": true
  },
  "items": {
    "permission-based-item-spawn": true,
    "drop-items-if-full": true,
    "oversized-stacksize": 64,
    "default-stack-size": -1,
    "unsafe-enchantments": true,
    "max-unsafe-enchantment-level": 32767,
    "item-spawn-blacklist": [
      "minecraft:bedrock",
      "minecraft:barrier",
      "minecraft:command_block",
      "minecraft:chain_command_block",
      "minecraft:repeating_command_block",
      "minecraft:structure_block",
      "minecraft:jigsaw",
      "minecraft:debug_stick",
      "minecraft:knowledge_book"
    ]
  },
  "permissions": {
    "useExternalPermissions": false,
    "defaultGroup": "default",
    "opsBypassPermissions": true,
    "cachePermissions": true,
    "permissionCacheExpiryMinutes": 30
  },
  "afk": {
    "enabled": true,
    "timeout": 300,
    "kickTimeout": 0,
    "kickMessage": "Kicked for being AFK too long",
    "enableBroadcasts": true,
    "broadcastOnAfk": true,
    "broadcastOnReturn": true,
    "afkMessage": "{player} is now AFK",
    "returnMessage": "{player} is no longer AFK",
    "customAfkMessage": "{player} is now AFK: {reason}",
    "enableTablistIndicator": true,
    "tablistAfkPrefix": "[AFK] ",
    "tablistAfkSuffix": "",
    "ignoreAfkInSleep": true,
    "enableActivityTracking": true,
    "trackMovement": true,
    "trackChat": true,
    "trackCommands": true,
    "trackInteractions": true,
    "movementThreshold": 0.1,
    "rotationThreshold": 5.0,
    "excludedCommands": ["afk", "list", "who", "tps", "ping", "help", "?"],
    "autoSave": true,
    "saveInterval": 60,
    "persistData": true
  },
  "chat": {
    "chat-format": "<{neoessentials_prefix} {neoessentials_username} {neoessentials_suffix}> {MESSAGE}",
    "chat-format-description": "Chat format template. Available placeholders: {neoessentials_displayname}, {neoessentials_username}, {MESSAGE}, {neoessentials_prefix}, {neoessentials_suffix}, {neoessentials_world}, {neoessentials_x}, {neoessentials_y}, {neoessentials_z}, {neoessentials_health}, {neoessentials_level}, and more via PlaceholderAPI",
    "enable-chat-formatting": true,
    "enable-color-codes": true,
    "muteCommands": [],
    "playerChatPermissions": [],
    "sleepIgnoresAfkPlayers": true,
    "sleepIgnoresVanishedPlayers": true,
    "afkListName": "none",
    "broadcastAfkMessage": true,
    "deathMessages": true,
    "vanishingItemsPolicy": "keep",
    "bindingItemsPolicy": "keep",
    "sendInfoAfterDeath": true,
    "allowSilentJoinQuit": false,
    "customJoinMessage_comment": "Custom join message template. Use 'none' for default. Available placeholders: {neoessentials_displayname}, {neoessentials_username}, {neoessentials_prefix}, {neoessentials_suffix}, {neoessentials_world}, and more via PlaceholderAPI. Example: '&a{neoessentials_prefix}&f{neoessentials_displayname} &ejoined the server!'",
    "customJoinMessage": "none",
    "customQuitMessage_comment": "Custom quit message template. Use 'none' for default. Available placeholders: {neoessentials_displayname}, {neoessentials_username}, {neoessentials_prefix}, {neoessentials_suffix}, {neoessentials_world}, and more via PlaceholderAPI. Example: '&c{neoessentials_prefix}&f{neoessentials_displayname} &eleft the server!'",
    "customQuitMessage": "none",
    "customNewUsernameMessage_comment": "Custom message for player name changes. Use 'none' for default. Available placeholders: {neoessentials_displayname}, {neoessentials_username}, {neoessentials_prefix}, {neoessentials_suffix}, and more via PlaceholderAPI. Example: '&6{neoessentials_prefix}&f{neoessentials_displayname} &echanged their name!'",
    "customNewUsernameMessage": "none",
    "useCustomServerFullMessage": false,
    "hideJoinQuitMessagesAbove": -1
  },
  "logging": {
    "enableTransactionLogging": true,
    "enablePermissionLogging": false,
    "enableDebugLogging": false,
    "logLevel": "INFO"
  }
}