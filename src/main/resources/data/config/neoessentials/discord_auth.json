{
  // DO NOT MODIFY: Used by NeoEssentials for automatic config updates.
  "_configVersion": 9,

  /* ================================================================
     Discord Authentication Configuration
     Dashboard login/identity + role-based Minecraft permissions,
     sourced from a Discord companion mod (Simple Discord Link or
     Mc2Discord) — NeoEssentials never talks to Discord directly.
  ================================================================ */

  // Enable/disable Discord-linked dashboard login. Requires a player to have already
  // linked their account in-game via Simple Discord Link or Mc2Discord's own commands.
  "enabled": false,

  // When true, dashboard login via Discord identity requires the player's Minecraft
  // account to actually be linked to Discord (recommended: true).
  "requireLinkedAccount": true,

  // Automatically create dashboard accounts for Discord users on first login (recommended: true)
  "allowAutoRegistration": true,

  // Default role for users with no Discord role mapping (ADMIN | MODERATOR | VIEWER)
  "defaultRole": "VIEWER",

  /* Map Discord role IDs to Dashboard roles.
   * Use role IDs (right-click a role in Discord → Copy ID) NOT role names.
   * Requires Discord Developer Mode: Discord Settings → Advanced → Developer Mode.
   */
  "roleMapping": {
    "709352979668533341": "ADMIN",
    "709353103530655857": "MODERATOR",
    "709353464475680788": "VIEWER"
  },

  // Define which dashboard roles each Discord role ID grants (for multi-role users)
  "roleHierarchy": {
    "709352979668533341": ["ADMIN", "MODERATOR", "VIEWER"],
    "709353103530655857": ["MODERATOR", "VIEWER"],
    "709353464475680788": ["VIEWER"]
  },

  // Only allow Discord users with these role IDs (empty = allow all)
  "whitelistedRoles": [],

  // Block specific Discord user IDs from logging in
  "blacklistedUsers": [],

  // Session duration in milliseconds (86400000 = 24 hours)
  "sessionDuration": 86400000,

  /* Automatically sync Minecraft permissions based on Discord roles.
   * When players join, their Discord roles are retrieved and mapped to Minecraft permissions.
   * Works with LuckPerms or the built-in permission system.
   */
  "permissionSync": {

    // Enable/disable Discord role → Minecraft permission synchronization
    "enabled": true,

    // Automatically sync permissions when a player joins the server (recommended: true)
    "syncOnJoin": true,

    /* Map Discord Role IDs to Minecraft permission nodes.
     * Players receive ALL permissions from ALL their Discord roles (permissions are combined).
     * Use Discord Role IDs (numbers), NOT role names.
     * Enable Developer Mode: Discord Settings → Advanced → Developer Mode, then
     *   Server Settings → Roles → right-click role → Copy ID.
     */
    "permissionMappings": {
      "709352979668533341": [
        "neoessentials.*",
        "neoessentials.dashboard.admin",
        "neoessentials.dashboard.temppass",
        "neoessentials.dashboard.status",
        "neoessentials.discord.syncperms.others"
      ],
      "709353103530655857": [
        "neoessentials.dashboard.temppass",
        "neoessentials.dashboard.status",
        "neoessentials.discord.syncperms",
        "neoessentials.kick",
        "neoessentials.mute",
        "neoessentials.ban"
      ],
      "709353464475680788": [
        "neoessentials.dashboard.status",
        "neoessentials.discord.syncperms",
        "neoessentials.home",
        "neoessentials.tpa",
        "neoessentials.warp"
      ]
    },

    /* Common permission mapping examples (for reference — not loaded by the mod):
     * admin_role   : ["neoessentials.*"]  — full access to all NeoEssentials features
     * mod_role     : ["neoessentials.dashboard.temppass","neoessentials.kick","neoessentials.mute"]
     * helper_role  : ["neoessentials.dashboard.status","neoessentials.discord.syncperms"]
     * member_role  : ["neoessentials.home","neoessentials.tpa","neoessentials.warp"]
     */
    "permissionMappings_common_examples": {}
  }
}
