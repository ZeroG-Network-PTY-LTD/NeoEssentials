{
  // DO NOT MODIFY: Used by NeoEssentials for automatic config updates.
  "_configVersion": 5,

  /* ================================================================
     NeoEssentials — Tablist Configuration  (tablist.json)
     Reload in-game: /tablist reload
     BungeeTabListPlus-inspired. Supports independent mode + proxy.
  ================================================================ */

  "tablist": {

    // Set false to restore the vanilla tablist appearance
    "enabled": true,

    /* Independent mode — when true, NeoEssentials is the sole owner of the tablist.
     * Proxy integration (BungeeCord/Velocity) is used for data only.
     * Set false only if a proxy-side plugin should own the tablist instead.
     */
    "independentMode": true,

    // How often the tablist header/footer updates in ticks (20 = 1 s). Lower = smoother, more traffic.
    "refreshInterval": 10,

    /* Color / formatting reference:
     *   &0–&9, &a–&f    legacy color codes (black → white)
     *   &k &l &m &n &o &r   obfuscated, bold, strikethrough, underline, italic, reset
     *   &#RRGGBB        inline hex color  e.g. &#FF5500
     *   <color:#RRGGBB>text</color>
     *   <gradient:RRGGBB-RRGGBB>text</gradient>   2-stop gradient
     *   <gradient:RR-RR-RR>text</gradient>        multi-stop gradient
     *   <rainbow>text</rainbow>
     *   <red>, <gold>, <green>, <aqua>, <blue>, …  named colors
     *   <bold>, <italic>, <underline>, <strikethrough>
     */

    /* Text displayed ABOVE the player list.
     * Array → animated frames (one frame shown per refreshInterval ticks).
     * Single string → static header.
     * Standard placeholders: {player} {displayname} {online} {max} {ping} {world}
     *   {tps} {time} {server_name} {x} {y} {z} {balance} {prefix} {suffix} {group}
     *   {newline} {bar}
     * BTLP-style: {network_online} {server_online:NAME} {current_server} {server_label}
     *   {rank_weight} {session_minutes} {session_hours} {level} {health} {max_health} {afk}
     * Animation: {animation:NAME}  — current frame of a named animation from animations.json
     */
    "header": [
      "<gradient:FFD700-FF8C00>&l✦ {server_name} ✦&r &8| &e{online}&8/&e{max} &7players",
      "<gradient:FF8C00-FFD700>&l✦ {server_name} ✦&r &8| &eTPS: {tps}",
      "<gradient:FFD700-FF8C00>&l✦ {server_name} ✦&r &8| &e{time}"
    ],

    // Text displayed BELOW the player list. Same syntax and placeholder support as header.
    "footer": [
      "&7TPS: {tps} &8| &7Ping: &a{ping}&7ms &8| <green>{world}",
      "&7Coords: &e{x}&7, &e{y}&7, &e{z} &8| &7World: &e{world}",
      "&7Balance: &a{balance} &8| &7Group: &#FFD700{group}"
    ],

    /* How each player's name appears in the player-list rows (scoreboard teams).
     * Supports: {prefix} {player} {suffix} {displayname} {group}
     * Plus all color/format syntax above.
     */
    "playerFormat": "&f{prefix}&r{player}{suffix}",

    // Hide vanished players from other players' tablists and {online} count.
    // Staff with 'neoessentials.vanish.see' always see them.
    "hideVanished": true,

    // Append afkSuffix to AFK players' names in the tablist
    "showAfkIndicator": true,

    // Suffix appended to AFK players' names. Supports all color syntax.
    "afkSuffix": " &7[AFK]",

    /* Above-head nametag prefix/suffix (also shown in the tablist row — Minecraft ties both
     * to the same scoreboard-team property, so they can't be set independently).
     * By default this is exactly the same prefix/suffix chat already uses (from the
     * permission system / LuckPerms if configured) — no setup needed to get a matching
     * nametag. Override it per-group or per-player below under "groups"/"players" using the
     * "nametagPrefix"/"nametagSuffix" keys, independently of chat, if you want the nametag to
     * say something different. These support the same {placeholder} tokens as header/footer
     * (e.g. {balance}, {group}, {online}, {ping}) and all color syntax.
     * Set "enabled": false to make NeoEssentials skip managing nametag text entirely (the
     * tablist sorting/columns still work) — use this if another mod/plugin should own it instead.
     */
    "nametagSettings": {
      "enabled": true
    },

    /* Quick per-group color override for {displayname} in header/footer.
     * Value is a color prefix prepended to the player's display name.
     * Supports &#RRGGBB hex. Use '' (empty string) to disable for a group.
     */
    "groupColors": {
      "owner":   "&#FF4444",
      "admin":   "&c",
      "mod":     "&6",
      "vip":     "&#00CFFF",
      "default": "&f"
    },

    /* Per-group header/footer AND nametag prefix/suffix overrides.
     * Players in matching groups see these frames instead of the global ones.
     * Priority: per-player > per-group > global (same rule for nametagPrefix/nametagSuffix,
     * which fall back to the permission system's prefix/suffix — same as chat — when omitted).
     * header/footer support animated arrays and all color syntax; nametagPrefix/nametagSuffix
     * are single strings (a scoreboard team prefix/suffix has no concept of animation frames).
     */
    "groups": {
      "admin": {
        "header": [
          "<gradient:FF0000-AA0000>&l⚑ ADMIN PANEL ⚑&r {newline}&8{player} — ping &e{ping}ms &8| tps {tps}",
          "<gradient:AA0000-FF0000>&l⚑ ADMIN PANEL ⚑&r {newline}&8Coords &e{x}&8, &e{y}&8, &e{z}"
        ],
        "footer": "&cAdmin tools: &f/vanish /kick /ban /mute &8| &7{world}"
        // Example (commented out — uncomment to use):
        // "nametagPrefix": "&c[Admin] ",
        // "nametagSuffix": ""
      },
      "mod": {
        "header": "<gradient:FFA500-FFD700>&l✪ Moderator ✪&r &8| &e{online}&8/&e{max} &7online",
        "footer": "&6Staff tools: &f/mute /warn /tempban &8| &7{world}"
      },
      "vip": {
        "header": [
          "<gradient:00CFFF-0080FF>&l★ VIP ★&r &8| &e{online}&8/&e{max} &7players",
          "<gradient:0080FF-00CFFF>&l★ VIP ★&r &8| &7Welcome back, &b{player}!"
        ],
        "footer": "&#00CFFF{player}&7 — &aBalance: &f{balance} &8| &7Ping: &a{ping}ms"
      }
    },

    /* Per-player header/footer AND nametag prefix/suffix overrides, keyed by player UUID.
     * These take the highest priority over group and global settings.
     * Runtime overrides via /tablist player <name> header|footer|nametag are NOT persisted
     * here — add them manually if you want them to survive /tablist reload.
     */
    "players": {
    },

    /* BungeeTabListPlus-style proxy integration.
     * Enable when this server runs behind a BungeeCord or Velocity proxy.
     * Placeholders: {network_online} {server_online:NAME} {current_server} {server_label}
     */
    "proxy": {
      "enabled": false,
      "serverLabel": "Main",
      "pollIntervalTicks": 100,
      "showNetworkPlayers": false,
      "knownServers": []
    },

    /* BTLP-style fake (decorative) tab entries.
     * Use for separator rows, section headers, or padding slots.
     * Fields: name (display text), latency (ms; -1 = no bar), id (unique slot key), listed (show in tab)
     * Supports all NeoEssentials color syntax in 'name'.
     */
    "fakePlayers": [],

    /* BTLP-inspired tab layout and player-sorting options.
     * columns            — 1–4 visual columns in the tab list
     * sortByGroupWeight  — sort players by permission-group weight (admins first)
     * groupSections      — insert separator rows between permission-group buckets
     * playersByServer    — group players by proxy server (requires proxy.enabled=true)
     * excludeServers     — server names fully excluded from this tab
     * hiddenServers      — server names whose players are hidden but the server may appear
     * maxSlotsPerColumn  — slots per column (default 20; 4×20 = 80-slot BTLP grid)
     */
    "layout": {
      "columns": 1,
      "sortByGroupWeight": true,
      "groupSections": false,
      "playersByServer": false,
      "excludeServers": [],
      "hiddenServers": [],
      "maxSlotsPerColumn": 20
    }
  }
}
