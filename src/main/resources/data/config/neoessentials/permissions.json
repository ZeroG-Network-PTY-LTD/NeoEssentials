{
  // DO NOT MODIFY: Used by NeoEssentials for automatic config updates.
  "_configVersion": 8,

  /* ================================================================
     NeoEssentials — Permissions  (permissions.json)

     This is the LIVE source of truth for every group listed below — read
     on every server start AND every "/permissions reload" / "/neoe reload"
     (only when using the internal permission system: permissions.
     useExternalPermissions: false in config.json). Edit a group's
     permissions/inherits/prefix/suffix/priority here, reload, and it
     takes effect immediately — CONFIG ALWAYS WINS: any changes made
     in-game via "/permissions group ..." commands to a group defined
     here are overwritten back to whatever this file says on the next
     reload or restart. Manage these groups by editing this file, not
     with in-game commands, or your in-game changes won't stick.

     "defaultGroup" is likewise re-applied on every load.

     A group NOT listed here (an entirely custom group you created
     in-game with a name that doesn't appear below) is left completely
     alone — this only overwrites groups that exist in this file.
     User-to-group assignments are never touched by this sync either.
  ================================================================ */

  // The group assigned to players with no explicit group
  "defaultGroup": "guest",

  // Ladder: guest -> member -> vip -> vipplus -> mod -> admin -> owner.
  // Only guest -> member promotes automatically (see permissionsAutoPromote
  // in config.json); vip/vipplus/mod/admin/owner are always assigned manually.
  "groups": [
    {
      "name": "guest",
      "prefix": "&7",
      "suffix": "",
      "priority": 0,
      "permissions": [
        "neoessentials.economy.balance",
        "neoessentials.economy.pay",
        "neoessentials.economy.pay.toggle",
        "neoessentials.economy.baltop",
        "neoessentials.item.repair",
        "neoessentials.item.dispose",
        "neoessentials.item.powertool",
        "neoessentials.chat.msg",
        "neoessentials.chat.reply",
        "neoessentials.chat.ignore",
        "neoessentials.chat.unignore",
        "neoessentials.chat.msgtoggle",
        "neoessentials.afk",
        "neoessentials.kits.use",
        "neoessentials.kits.list",
        "neoessentials.teleport.home",
        "neoessentials.teleport.home.set",
        "neoessentials.teleport.home.delete",
        "neoessentials.teleport.home.list",
        "neoessentials.teleport.spawn",
        "neoessentials.teleport.warp",
        "neoessentials.teleport.warp.list",
        "neoessentials.teleport.request.tpa",
        "neoessentials.teleport.request.tpahere",
        "neoessentials.teleport.request.accept",
        "neoessentials.teleport.request.deny",
        "neoessentials.teleport.request.cancel",
        "neoessentials.teleport.back",
        "neoessentials.teleport.top",
        "neoessentials.pvp.status",
        "neoessentials.pvp.toggle",
        "neoessentials.info",
        "neoessentials.help"
      ],
      "inherits": []
    },
    {
      "name": "member",
      "prefix": "&f",
      "suffix": "",
      "priority": 1,
      // Auto-promoted from guest after 24h /playtime (permissionsAutoPromote in config.json).
      // A few more home slots than guest as the first rung's reward.
      "permissions": [
        "neoessentials.home.5"
      ],
      "inherits": ["guest"]
    },
    {
      "name": "vip",
      "prefix": "&b[VIP] ",
      "suffix": "",
      "priority": 2,
      "permissions": [
        "neoessentials.home.7"
      ],
      "inherits": ["member"]
    },
    {
      "name": "vipplus",
      "prefix": "&d[VIP+] ",
      "suffix": "",
      "priority": 3,
      "permissions": [
        "neoessentials.home.10"
      ],
      "inherits": ["vip"]
    },
    {
      "name": "mod",
      "prefix": "&2[Mod] ",
      "suffix": "",
      "priority": 4,
      "permissions": [
        "neoessentials.economy.balance.others",
        "neoessentials.economy.admin",
        "neoessentials.item.*",
        "neoessentials.chat.mute",
        "neoessentials.chat.socialspy",
        "neoessentials.afk.exempt",
        "neoessentials.permissions.reload",
        "neoessentials.permissions.list",
        "neoessentials.teleport.admin.tp",
        "neoessentials.teleport.admin.tphere",
        "neoessentials.teleport.admin.tppos",
        "neoessentials.teleport.home.others",
        "neoessentials.teleport.warp.create",
        "neoessentials.teleport.warp.delete",
        "neoessentials.teleport.spawn.set",
        "neoessentials.teleport.jump",
        "neoessentials.teleport.jumpto",
        "neoessentials.teleport.tpr",
        "neoessentials.invsee",
        "neoessentials.enderchest",
        "neoessentials.moderation.kick",
        "neoessentials.moderation.kickall",
        "neoessentials.moderation.ban",
        "neoessentials.moderation.banip",
        "neoessentials.moderation.banlist",
        "neoessentials.moderation.tempban",
        "neoessentials.moderation.tempbanip",
        "neoessentials.moderation.unban",
        "neoessentials.moderation.unbanip",
        "neoessentials.moderation.mute",
        "neoessentials.moderation.unmute",
        "neoessentials.moderation.freeze",
        "neoessentials.moderation.unfreeze",
        "neoessentials.moderation.freezelist",
        "neoessentials.moderation.vanish",
        "neoessentials.moderation.seevanished",
        "neoessentials.moderation.jail",
        "neoessentials.moderation.unjail",
        "neoessentials.moderation.jaillist",
        "neoessentials.moderation.jailinfo",
        "neoessentials.moderation.notifications",
        "neoessentials.moderation.warn",
        "neoessentials.moderation.warnings",
        "neoessentials.pvp.admin"
      ],
      // Staff inherit every donor perk on top of their moderation permissions.
      "inherits": ["vipplus"]
    },
    {
      "name": "admin",
      "prefix": "&c[Admin] ",
      "suffix": "",
      "priority": 5,
      "permissions": [
        "neoessentials.*"
      ],
      "inherits": ["mod"]
    },
    {
      "name": "owner",
      "prefix": "&6[Owner] ",
      "suffix": "",
      "priority": 6,
      "permissions": [
        "neoessentials.*"
      ],
      "inherits": ["admin"]
    }
  ]
}
