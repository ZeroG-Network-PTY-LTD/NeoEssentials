{
  // DO NOT MODIFY: Used by NeoEssentials for automatic config updates.
  "_configVersion": 2,

  /* ================================================================
     NeoEssentials — Kits  (kits.json)
     Fields: name, cooldown (seconds, -1 = one-time only), items[], commands[]

     IMPORTANT: this file is only read ONCE, on first boot (or the first
     boot after switching storage.type), to seed the active storage backend
     (json/yaml/sqlite/mysql, see storage.type in config.json). After that
     one-time import, this file is never read again — editing it later does
     nothing. Once a server has real kit data, use /createkit, /delkit, and
     the in-game kit commands (or the dashboard) instead; they write
     straight to the active backend.
  ================================================================ */

  "kits": [
    {
      "name": "starter",
      // Cooldown in seconds before the kit can be claimed again (86400 = 24 hours, -1 = one-time)
      "cooldown": 86400,
      "items": [
        {
          "item": "minecraft:stone_sword",
          "count": 1,
          "nbt": "{}"
        },
        {
          "item": "minecraft:bread",
          "count": 16,
          "nbt": "{}"
        }
      ],
      // Commands run as console when the kit is claimed ({player} = player name)
      "commands": [
        "say Welcome to the server, {player}!"
      ]
    }
  ]
}