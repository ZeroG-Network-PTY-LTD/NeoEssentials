                    .events-list, .players-list { 
                        background: rgba(255,255,255,0.95); border-radius: 20px; padding: 25px;
                        box-shadow: 0 20px 60px rgba(0,0,0,0.1); backdrop-filter: blur(20px);
                        border: 1px solid rgba(255,255,255,0.2);
                    }
                    .events-list h3, .players-list h3 {
                        color: #4a5568; margin-bottom: 20px; font-size: 1.3rem;
                        padding-bottom: 10px; border-bottom: 2px solid #e2e8f0;
                    }
                    .events-container, .players-container { 
                        max-height: 400px; overflow-y: auto; padding-right: 10px;
                    }
                    .event-item, .player-item { 
                        background: linear-gradient(135deg, #f7fafc, #edf2f7); 
                        border-radius: 12px; padding: 15px; margin-bottom: 12px;
                        border-left: 4px solid #4299e1; transition: all 0.2s ease;
                        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
                    }
                    .event-item:hover, .player-item:hover {
                        transform: translateX(5px); box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                    }
                    .event-time { color: #718096; font-size: 0.85rem; font-weight: 600; }
                    .event-message { color: #4a5568; margin-top: 5px; }
                    .player-name { color: #4a5568; font-weight: 600; font-size: 1.1rem; }
                    .player-info { color: #718096; font-size: 0.9rem; margin-top: 3px; }
                    .status-indicator {
                        display: inline-block; width: 12px; height: 12px; border-radius: 50%;
                        margin-right: 8px; animation: pulse 2s infinite;
                    }
                    .status-online { background: #48bb78; }
                    .status-warning { background: #ed8936; }
                    .status-error { background: #f56565; }
                    @keyframes pulse {
                        0% { opacity: 1; }
                        50% { opacity: 0.5; }
                        100% { opacity: 1; }
                    }
                    .progress-bar {
                        width: 100%; height: 8px; background: #e2e8f0; border-radius: 4px;
                        overflow: hidden; margin-top: 10px;
                    }
                    .progress-fill {
                        height: 100%; background: linear-gradient(135deg, #667eea, #764ba2);
                        transition: width 0.3s ease; border-radius: 4px;
                    }
                    @media (max-width: 768px) {
                        .content-grid { grid-template-columns: 1fr; }
                        .stats-grid { grid-template-columns: 1fr; }
                        .header h1 { font-size: 2rem; }
                    }
                </style>
            </head>
            <body>
                <div class="container">
                    <div class="header">
                        <h1>NeoEssentials Dashboard</h1>
                        <p>Real-time Server Monitoring & Management</p>
                        <div style="margin-top: 15px;">
                            <span class="status-indicator status-online" id="connection-status"></span>
                            <span id="connection-text">Connected</span>
                        </div>
                    </div>
                    
                    <div class="stats-grid">
                        <div class="stat-card">
                            <h3>Server Status</h3>
                            <div class="stat-value" id="server-status">Online</div>
                            <div class="stat-label">Current Status</div>
                            <div class="stat-trend trend-up" id="uptime-display">Uptime: Loading...</div>
                        </div>
                        <div class="stat-card">
                            <h3>Players Online</h3>
                            <div class="stat-value" id="player-count">0</div>
                            <div class="stat-label">Connected Players</div>
                            <div class="progress-bar">
                                <div class="progress-fill" id="player-progress" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="stat-card">
                            <h3>Server Performance</h3>
                            <div class="stat-value" id="server-tps">20.0</div>
                            <div class="stat-label">Ticks Per Second</div>
                            <div class="stat-trend" id="tps-trend">Optimal</div>
                        </div>
                        <div class="stat-card">
                            <h3>Memory Usage</h3>
                            <div class="stat-value" id="memory-usage">0%</div>
                            <div class="stat-label" id="memory-details">0 MB / 0 MB</div>
                            <div class="progress-bar">
                                <div class="progress-fill" id="memory-progress" style="width: 0%"></div>
                            </div>
                        </div>
                        <div class="stat-card">
                            <h3>World Information</h3>
                            <div class="stat-value" id="world-day">Day 0</div>
                            <div class="stat-label" id="world-time">00:00</div>
                            <div class="stat-trend" id="world-info">Loading...</div>
                        </div>
                        <div class="stat-card">
                            <h3>Server Load</h3>
                            <div class="stat-value" id="cpu-usage">0%</div>
                            <div class="stat-label">CPU Usage</div>
                            <div class="stat-trend" id="entities-count">Entities: 0</div>
                        </div>
                    </div>
                    
                    <div class="content-grid">
                        <div class="events-list">
                            <h3>Recent Server Events</h3>
                            <div class="events-container" id="events-container">
                                <div class="loading">Loading events...</div>
                            </div>
                        </div>
                        
                        <div class="players-list">
                            <h3>Online Players</h3>
                            <div class="players-container" id="players-container">
                                <div class="loading">Loading players...</div>
                            </div>
                        </div>
                    </div>
                    
                    <button class="refresh-btn" onclick="refreshData()">🔄 Refresh Dashboard</button>
                </div>
                
                <script>
                    let lastRefresh = Date.now();
                    
                    function updateElement(id, value) {
                        const el = document.getElementById(id);
                        if (el) el.textContent = value;
                    }
                    
                    function updateElementHTML(id, html) {
                        const el = document.getElementById(id);
                        if (el) el.innerHTML = html;
                    }
                    
                    function addEvent(message, type = 'info') {
                        const container = document.getElementById('events-container');
                        if (!container) return;
                        
                        if (container.querySelector('.loading')) {
                            container.innerHTML = '';
                        }
                        
                        const eventDiv = document.createElement('div');
                        eventDiv.className = 'event-item';
                        eventDiv.innerHTML = `
                            <div class="event-time">${new Date().toLocaleTimeString()}</div>
                            <div class="event-message">${message}</div>
                        `;
                        container.insertBefore(eventDiv, container.firstChild);
                        
                        while (container.children.length > 15) {
                            container.removeChild(container.lastChild);
                        }
                    }
                    
                    function addPlayer(playerData) {
                        const container = document.getElementById('players-container');
                        if (!container) return;
                        
                        if (container.querySelector('.loading')) {
                            container.innerHTML = '';
                        }
                        
                        const playerDiv = document.createElement('div');
                        playerDiv.className = 'player-item';
                        playerDiv.innerHTML = `
                            <div class="player-name">${playerData.name || playerData}</div>
                            <div class="player-info">${playerData.world || 'Unknown World'} • Ping: ${playerData.ping || 'N/A'}ms</div>
                        `;
                        container.appendChild(playerDiv);
                    }
                    
                    function formatUptime(ms) {
                        const seconds = Math.floor(ms / 1000);
                        const minutes = Math.floor(seconds / 60);
                        const hours = Math.floor(minutes / 60);
                        const days = Math.floor(hours / 24);
                        
                        if (days > 0) {
                            return `${days}d ${hours % 24}h ${minutes % 60}m`;
                        } else if (hours > 0) {
                            return `${hours}h ${minutes % 60}m ${seconds % 60}s`;
                        } else {
                            return `${minutes}m ${seconds % 60}s`;
                        }
                    }
                    
                    function formatWorldTime(ticks) {
                        const totalMinutes = Math.floor(ticks / 16.67); // 1 minute = ~16.67 ticks
                        const hours = Math.floor((totalMinutes + 360) / 60) % 24; // Start at 6:00 AM
                        const minutes = totalMinutes % 60;
                        return `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}`;
                    }
                    
                    async function refreshData() {
                        try {
                            // Update connection status
                            updateElement('connection-text', 'Refreshing...');
                            
                            // Fetch dashboard data
                            const response = await fetch('/api/data');
                            if (response.ok) {
                                const data = await response.json();
                                
                                // Update basic stats
                                updateElement('player-count', data.player_count || 0);
                                updateElement('server-tps', (data.tps || 20).toFixed(1));
                                updateElement('memory-usage', (data.memory_usage || 0).toFixed(1) + '%');
                                
                                // Update memory details
                                const memUsed = data.memory_used_mb || 0;
                                const memMax = data.memory_max_mb || 0;
                                updateElement('memory-details', `${memUsed} MB / ${memMax} MB`);
                                
                                // Update progress bars
                                const memProgress = document.getElementById('memory-progress');
                                if (memProgress) memProgress.style.width = (data.memory_usage || 0) + '%';
                                
                                const playerProgress = document.getElementById('player-progress');
                                const maxPlayers = data.max_players || 20;
                                const playerPercent = ((data.player_count || 0) / maxPlayers) * 100;
                                if (playerProgress) playerProgress.style.width = playerPercent + '%';
                                
                                // Update uptime
                                if (data.uptime) {
                                    updateElement('uptime-display', 'Uptime: ' + formatUptime(data.uptime));
                                }
                                
                                // Update world information
                                if (data.world_time !== undefined) {
                                    const worldTime = formatWorldTime(data.world_time);
                                    updateElement('world-time', worldTime);
                                    updateElement('world-day', `Day ${Math.floor((data.world_day || 0) + 1)}`);
                                }
                                
                                // Update world info
                                const chunks = data.loaded_chunks || 0;
                                const entities = data.entities || 0;
                                updateElement('world-info', `Chunks: ${chunks} • Entities: ${entities}`);
                                updateElement('entities-count', `Entities: ${entities}`);
                                
                                // Update CPU usage
                                updateElement('cpu-usage', (data.cpu_usage || 0).toFixed(1) + '%');
                                
                                // Update TPS trend
                                const tps = data.tps || 20;
                                const tpsTrend = document.getElementById('tps-trend');
                                if (tpsTrend) {
                                    if (tps >= 19) {
                                        tpsTrend.textContent = 'Excellent';
                                        tpsTrend.className = 'stat-trend trend-up';
                                    } else if (tps >= 15) {
                                        tpsTrend.textContent = 'Good';
                                        tpsTrend.className = 'stat-trend';
                                    } else {
                                        tpsTrend.textContent = 'Poor';
                                        tpsTrend.className = 'stat-trend trend-down';
                                    }
                                }
                                
                                // Add events if available
                                if (data.events) {
                                    data.events.forEach(event => addEvent(event.message || event));
                                }
                            }
                            
                            // Fetch players
                            const playersResponse = await fetch('/api/players');
                            if (playersResponse.ok) {
                                const players = await playersResponse.json();
                                const container = document.getElementById('players-container');
                                if (container && players.players) {
                                    container.innerHTML = '';
                                    if (players.players.length === 0) {
                                        container.innerHTML = '<div class="loading">No players online</div>';
                                    } else {
                                        players.players.forEach(player => addPlayer(player));
                                    }
                                }
                            }
                            
                            // Update connection status
                            updateElement('connection-text', 'Connected');
                            lastRefresh = Date.now();
                            
                        } catch (error) {
                            console.error('Failed to refresh data:', error);
                            updateElement('connection-text', 'Connection Error');
                            addEvent('Failed to refresh dashboard data', 'error');
                        }
                    }
                    
                    // Initial load
                    document.addEventListener('DOMContentLoaded', () => {
                        refreshData();
                        addEvent('Dashboard initialized successfully');
                        
                        // Auto-refresh every 10 seconds
                        setInterval(refreshData, 10000);
                        
                        // Update last refresh time every second
                        setInterval(() => {
                            const timeSince = Math.floor((Date.now() - lastRefresh) / 1000);
                            if (timeSince > 30) {
                                updateElement('connection-text', `Last update: ${timeSince}s ago`);
                            }
                        }, 1000);
                    });
                </script>
            </body>
            </html>
            """;
    }
}
