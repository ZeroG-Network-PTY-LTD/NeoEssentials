    /**
     * Get online players information
     */
    private List<Map<String, Object>> getOnlinePlayers() {
        List<Map<String, Object>> players = new ArrayList<>();
        
        try {
            net.minecraft.server.MinecraftServer server = net.neoforged.neoforge.server.ServerLifecycleHooks.getCurrentServer();
            if (server != null && server.getPlayerList() != null) {
                for (net.minecraft.server.level.ServerPlayer player : server.getPlayerList().getPlayers()) {
                    Map<String, Object> playerData = new HashMap<>();
                    playerData.put("name", player.getName().getString());
                    playerData.put("uuid", player.getUUID().toString());
                    playerData.put("dimension", player.level().dimension().location().toString());
                    playerData.put("x", (int) player.getX());
                    playerData.put("y", (int) player.getY());
                    playerData.put("z", (int) player.getZ());
                    playerData.put("health", player.getHealth());
                    playerData.put("gamemode", player.gameMode.getGameModeForPlayer().getName());
                    players.add(playerData);
                }
            }
        } catch (Exception e) {
            com.zerog.neoessentials.util.DebugUtil.warnLog("Error getting online players: " + e.getMessage());
        }
        
        return players;
    }
    
    /**
     * Enhanced Dashboard session class with IP tracking and activity monitoring
     */
    public static class DashboardSession {
        private final String sessionId;
        private final String username;
        private final long createdTime;
        private final String ipAddress;
        private long lastActivity;
        private int requestCount;
        
        public DashboardSession(String sessionId, String username, long createdTime) {
            this(sessionId, username, createdTime, "unknown");
        }
        
        public DashboardSession(String sessionId, String username, long createdTime, String ipAddress) {
            this.sessionId = sessionId;
            this.username = username;
            this.createdTime = createdTime;
            this.ipAddress = ipAddress;
            this.lastActivity = createdTime;
            this.requestCount = 0;
        }
        
        public String getSessionId() {
            return sessionId;
        }
        
        public String getUsername() {
            return username;
        }
        
        public long getCreatedTime() {
            return createdTime;
        }
        
        public String getIpAddress() {
            return ipAddress;
        }
        
        public long getLastActivity() {
            return lastActivity;
        }
        
        public void updateLastActivity() {
            this.lastActivity = System.currentTimeMillis();
            this.requestCount++;
        }
        
        public int getRequestCount() {
            return requestCount;
        }
        
        public long getSessionDuration() {
            return System.currentTimeMillis() - createdTime;
        }
        
        public boolean isExpired(long timeoutMs) {
            return (System.currentTimeMillis() - lastActivity) > timeoutMs;
        }
    }
    
    /**
     * Main dashboard page handler
     */
    private class DashboardHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            String method = exchange.getRequestMethod();
            
            if ("GET".equals(method)) {
                try {
                    // Load dashboard HTML
                    String html = WebDashboardManager.this.getEmbeddedDashboardHtml();
                    
                    // Set response headers
                    exchange.getResponseHeaders().set("Content-Type", "text/html; charset=UTF-8");
                    exchange.getResponseHeaders().set("Cache-Control", "no-cache");
                    
                    // Send response
                    byte[] response = html.getBytes(StandardCharsets.UTF_8);
                    exchange.sendResponseHeaders(200, response.length);
                    
                    try (OutputStream os = exchange.getResponseBody()) {
                        os.write(response);
                    }
                } catch (Exception e) {
                    com.zerog.neoessentials.util.DebugUtil.errorLog("Error serving dashboard: " + e.getMessage());
                    WebDashboardManager.this.sendErrorResponse(exchange, 500, "Internal Server Error");
                }
            } else {
                WebDashboardManager.this.sendErrorResponse(exchange, 405, "Method Not Allowed");
            }
        }
    }
    
    /**
     * API data handler for dashboard updates
     */
    private class ApiDataHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            String method = exchange.getRequestMethod();
            
            if ("GET".equals(method)) {
                try {
                    // Refresh data before serving
                    collectPerformanceMetrics();
                    
                    // Get current dashboard data
                    Map<String, Object> data = WebDashboardManager.this.getDashboardData();
                    
                    // Add additional real-time data
                    net.minecraft.server.MinecraftServer server = net.minecraft.server.MinecraftServer.getServer();
                    if (server != null) {
                        // Add recent events
                        List<Map<String, Object>> events = new ArrayList<>();
                        events.add(Map.of("message", "Server running smoothly", "time", System.currentTimeMillis()));
                        events.add(Map.of("message", "Performance monitoring active", "time", System.currentTimeMillis() - 30000));
                        events.add(Map.of("message", "Dashboard connected", "time", System.currentTimeMillis() - 60000));
                        data.put("events", events);
                        
                        // Add current timestamp
                        data.put("timestamp", System.currentTimeMillis());
                        data.put("server_start_time", server.getServerStartTime());
                        
                        // Add more detailed server info
                        data.put("minecraft_version", server.getServerVersion());
                        data.put("difficulty", server.getWorldData().getDifficulty().getDisplayName().getString());
                        data.put("gamemode", server.getWorldData().getSettings().gameType().getName());
                        data.put("hardcore", server.getWorldData().isHardcore());
                        
                        // Add dimension count
                        data.put("dimension_count", server.getAllLevels().size());
                        
                        // Add total world size info
                        long totalChunks = 0;
                        long totalEntities = 0;
                        for (net.minecraft.server.level.ServerLevel level : server.getAllLevels()) {
                            totalChunks += level.getChunkSource().getLoadedChunksCount();
                            totalEntities += level.getEntityCount();
                        }
                        data.put("total_loaded_chunks", totalChunks);
                        data.put("total_entities", totalEntities);
                    }
                    
                    // Convert to JSON
                    String json = WebDashboardManager.this.mapToJson(data);
                    
                    // Set response headers
                    exchange.getResponseHeaders().set("Content-Type", "application/json");
                    exchange.getResponseHeaders().set("Access-Control-Allow-Origin", "*");
                    exchange.getResponseHeaders().set("Cache-Control", "no-cache");
                    
                    // Send response
                    byte[] response = json.getBytes(StandardCharsets.UTF_8);
                    exchange.sendResponseHeaders(200, response.length);
                    
                    try (OutputStream os = exchange.getResponseBody()) {
                        os.write(response);
                    }
                } catch (Exception e) {
                    com.zerog.neoessentials.util.DebugUtil.errorLog("Error serving API data: " + e.getMessage());
                    WebDashboardManager.this.sendErrorResponse(exchange, 500, "Internal Server Error");
                }
            } else {
                WebDashboardManager.this.sendErrorResponse(exchange, 405, "Method Not Allowed");
            }
        }
    }
    
