    /**
     * API players handler for online players
     */
    private class ApiPlayersHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            String method = exchange.getRequestMethod();
            
            if ("GET".equals(method)) {
                try {
                    // Get online players with enhanced data
                    List<Map<String, Object>> players = new ArrayList<>();
                    
                    net.minecraft.server.MinecraftServer server = net.neoforged.neoforge.server.ServerLifecycleHooks.getCurrentServer();
                    if (server != null && server.getPlayerList() != null) {
                        for (net.minecraft.server.level.ServerPlayer player : server.getPlayerList().getPlayers()) {
                            Map<String, Object> playerData = new HashMap<>();
                            playerData.put("name", player.getName().getString());
                            playerData.put("uuid", player.getUUID().toString());
                            playerData.put("world", player.level().dimension().location().getPath());
                            playerData.put("x", Math.round(player.getX()));
                            playerData.put("y", Math.round(player.getY()));
                            playerData.put("z", Math.round(player.getZ()));
                            playerData.put("health", Math.round(player.getHealth() * 10) / 10.0);
                            playerData.put("max_health", Math.round(player.getMaxHealth() * 10) / 10.0);
                            playerData.put("food", player.getFoodData().getFoodLevel());
                            playerData.put("level", player.experienceLevel);
                            playerData.put("gamemode", player.gameMode.getGameModeForPlayer().getName());
                            playerData.put("ping", player.connection.latency());
                            
                            // Add playtime if available
                            playerData.put("playtime", "N/A"); // Could be enhanced with actual playtime tracking
                            
                            players.add(playerData);
                        }
                    }
                    
                    // Create response object
                    Map<String, Object> response = new HashMap<>();
                    response.put("players", players);
                    response.put("count", players.size());
                    response.put("max_players", server != null ? server.getMaxPlayers() : 20);
                    response.put("timestamp", System.currentTimeMillis());
                    
                    // Convert to JSON
                    String json = WebDashboardManager.this.mapToJson(response);
                    
                    // Set response headers
                    exchange.getResponseHeaders().set("Content-Type", "application/json");
                    exchange.getResponseHeaders().set("Access-Control-Allow-Origin", "*");
                    exchange.getResponseHeaders().set("Cache-Control", "no-cache");
                    
                    // Send response
                    byte[] responseBytes = json.getBytes(StandardCharsets.UTF_8);
                    exchange.sendResponseHeaders(200, responseBytes.length);
                    
                    try (OutputStream os = exchange.getResponseBody()) {
                        os.write(responseBytes);
                    }
                } catch (Exception e) {
                    com.zerog.neoessentials.util.DebugUtil.errorLog("Error serving API players: " + e.getMessage());
                    WebDashboardManager.this.sendErrorResponse(exchange, 500, "Internal Server Error");
                }
            } else {
                WebDashboardManager.this.sendErrorResponse(exchange, 405, "Method Not Allowed");
            }
        }
    }
    
    /**
     * Static resource handler for CSS, JS, and other assets
     */
    private class StaticResourceHandler implements HttpHandler {
        private final String resourceType;
        
        public StaticResourceHandler(String resourceType) {
            this.resourceType = resourceType;
        }
        
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            String method = exchange.getRequestMethod();
            
            if ("GET".equals(method)) {
                String path = exchange.getRequestURI().getPath();
                try {
                    String content = loadStaticResource(path);
                    String contentType = getContentType(path);
                    
                    // Set response headers
                    exchange.getResponseHeaders().set("Content-Type", contentType);
                    exchange.getResponseHeaders().set("Cache-Control", "public, max-age=3600");
                    
                    // Send response
                    byte[] response = content.getBytes(StandardCharsets.UTF_8);
                    exchange.sendResponseHeaders(200, response.length);
                    
                    try (OutputStream os = exchange.getResponseBody()) {
                        os.write(response);
                    }
                } catch (Exception e) {
                    com.zerog.neoessentials.util.DebugUtil.errorLog("Error serving static resource " + path + ": " + e.getMessage());
                    sendErrorResponse(exchange, 404, "Not Found");
                }
            } else {
                sendErrorResponse(exchange, 405, "Method Not Allowed");
            }
        }
    }
    
    /**
     * Load dashboard HTML content
     */
    private String loadDashboardHtml() throws IOException {
        // Try to load from resources first
        try (InputStream is = getClass().getResourceAsStream("/assets/neoessentials/web/dashboard.html")) {
            if (is != null) {
                return new String(is.readAllBytes(), StandardCharsets.UTF_8);
            }
        } catch (Exception e) {
            com.zerog.neoessentials.util.DebugUtil.warnLog("Could not load dashboard.html from resources: " + e.getMessage());
        }
        
        // Fallback to embedded HTML
        return getEmbeddedDashboardHtml();
    }
    
    /**
     * Load static resource content
     */
    private String loadStaticResource(String path) throws IOException {
        // Try to load from resources
        try (InputStream is = getClass().getResourceAsStream("/assets/neoessentials/web" + path)) {
            if (is != null) {
                return new String(is.readAllBytes(), StandardCharsets.UTF_8);
            }
        } catch (Exception e) {
            com.zerog.neoessentials.util.DebugUtil.warnLog("Could not load static resource " + path + ": " + e.getMessage());
        }
        
        throw new IOException("Resource not found: " + path);
    }
    
    /**
     * Get content type for file extension
     */
    private String getContentType(String path) {
        if (path.endsWith(".css")) return "text/css";
        if (path.endsWith(".js")) return "application/javascript";
        if (path.endsWith(".html")) return "text/html";
        if (path.endsWith(".json")) return "application/json";
        if (path.endsWith(".png")) return "image/png";
        if (path.endsWith(".jpg") || path.endsWith(".jpeg")) return "image/jpeg";
        if (path.endsWith(".svg")) return "image/svg+xml";
        return "text/plain";
    }
    
    /**
     * Send error response
     */
    private void sendErrorResponse(HttpExchange exchange, int code, String message) throws IOException {
        String response = "<html><body><h1>" + code + " " + message + "</h1></body></html>";
        exchange.getResponseHeaders().set("Content-Type", "text/html");
        byte[] responseBytes = response.getBytes(StandardCharsets.UTF_8);
        exchange.sendResponseHeaders(code, responseBytes.length);
        
        try (OutputStream os = exchange.getResponseBody()) {
            os.write(responseBytes);
        }
    }
    
    /**
     * Convert map to JSON string (simple implementation)
     */
    private String mapToJson(Map<String, Object> map) {
        StringBuilder json = new StringBuilder("{");
        boolean first = true;
        
        for (Map.Entry<String, Object> entry : map.entrySet()) {
            if (!first) json.append(",");
            json.append("\"").append(entry.getKey()).append("\":");
            json.append(objectToJson(entry.getValue()));
            first = false;
        }
        
        json.append("}");
        return json.toString();
    }
    
    /**
     * Convert list to JSON string
     */
    private String listToJson(List<?> list) {
        StringBuilder json = new StringBuilder("[");
        boolean first = true;
        
        for (Object item : list) {
            if (!first) json.append(",");
            json.append(objectToJson(item));
            first = false;
        }
        
        json.append("]");
        return json.toString();
    }
    
    /**
     * Convert object to JSON representation
     */
    private String objectToJson(Object obj) {
        if (obj == null) return "null";
        if (obj instanceof String) return "\"" + obj.toString().replace("\"", "\\\"") + "\"";
        if (obj instanceof Number || obj instanceof Boolean) return obj.toString();
        if (obj instanceof Map) return mapToJson((Map<String, Object>) obj);
        if (obj instanceof List) return listToJson((List<?>) obj);
        return "\"" + obj.toString().replace("\"", "\\\"") + "\"";
    }
    
    /**
     * Get embedded dashboard HTML when resources are not available
     */
    private String getEmbeddedDashboardHtml() {
        return """
            <!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <title>NeoEssentials Dashboard</title>
                <style>
                    * { margin: 0; padding: 0; box-sizing: border-box; }
                    body { 
                        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
                        min-height: 100vh; color: #333; padding: 20px; overflow-x: hidden;
                    }
                    .container { max-width: 1400px; margin: 0 auto; }
                    .header { 
                        background: rgba(255,255,255,0.95); backdrop-filter: blur(20px);
                        border-radius: 20px; padding: 30px; margin-bottom: 30px;
                        box-shadow: 0 20px 60px rgba(0,0,0,0.1); text-align: center;
                        border: 1px solid rgba(255,255,255,0.2);
                    }
                    .header h1 { 
                        color: #2d3748; font-size: 3rem; margin-bottom: 10px; 
                        background: linear-gradient(135deg, #667eea, #764ba2);
                        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
                        background-clip: text;
                    }
                    .header p { color: #718096; font-size: 1.1rem; }
                    .stats-grid { 
                        display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                        gap: 25px; margin-bottom: 30px;
                    }
                    .stat-card { 
                        background: rgba(255,255,255,0.95); backdrop-filter: blur(20px);
                        border-radius: 20px; padding: 30px; box-shadow: 0 20px 60px rgba(0,0,0,0.1);
                        transition: all 0.3s ease; border: 1px solid rgba(255,255,255,0.2);
                        position: relative; overflow: hidden;
                    }
                    .stat-card::before {
                        content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
                        background: linear-gradient(135deg, #667eea, #764ba2);
                    }
                    .stat-card:hover { transform: translateY(-10px); box-shadow: 0 30px 80px rgba(0,0,0,0.15); }
                    .stat-card h3 { 
                        color: #4a5568; margin-bottom: 20px; font-size: 1.1rem;
                        text-transform: uppercase; letter-spacing: 1px; font-weight: 600;
