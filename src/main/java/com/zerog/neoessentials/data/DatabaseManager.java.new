    /**
     * Migrate transactions from one database to another
     */
    private void migrateTransactions(DatabaseManager source) throws SQLException {
        // Check if transactions table exists in source
        boolean hasTransactionsTable = source.executeOperation(conn -> {
            try {
                Statement stmt = conn.createStatement();
                stmt.executeQuery("SELECT 1 FROM transactions LIMIT 1");
                return true;
            } catch (SQLException e) {
                // Table doesn't exist
                return false;
            }
        });
        
        if (hasTransactionsTable) {
            NeoEssentials.LOGGER.info("Migrating transactions...");
            // Implement transaction migration similar to above patterns
        } else {
            NeoEssentials.LOGGER.info("Transactions table not found in source, skipping migration");
        }
    }
    
