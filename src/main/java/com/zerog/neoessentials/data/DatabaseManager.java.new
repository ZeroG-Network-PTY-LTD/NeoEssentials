package com.zerog.neoessentials.data;

import com.zaxxer.hikari.HikariConfig;
import com.zaxxer.hikari.HikariDataSource;
import com.zerog.neoessentials.NeoEssentials;
import com.zerog.neoessentials.config.StorageType;

import java.io.File;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;
import java.util.HashMap;
import java.util.Map;
import java.util.Properties;
import java.util.UUID;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicBoolean;

/**
 * Manages database operations for the NeoEssentials mod.
 * Supports both SQLite and MySQL database backends with connection pooling.
 */
public class DatabaseManager {
    // Connection pool for database access
    private HikariDataSource dataSource;
    
    // Storage configuration
    private final StorageType storageType;
    private final String dbHost;
    private final int dbPort;
    private final String dbName;
    private final String dbUser;
    private final String dbPassword;
    private final String dbFile;
    
    // State tracking
    private final AtomicBoolean initialized = new AtomicBoolean(false);
    private final AtomicBoolean shuttingDown = new AtomicBoolean(false);
    
    // Schema version tracking
    private static final int CURRENT_SCHEMA_VERSION = 1;
    
    /**
     * Constructor for the DatabaseManager
     * 
     * @param storageType The type of storage (JSON, SQLITE, MYSQL)
     * @param dbHost MySQL host address (ignored for SQLite)
     * @param dbPort MySQL port (ignored for SQLite)
     * @param dbName Database name (or SQLite filename without extension)
     * @param dbUser MySQL username (ignored for SQLite)
     * @param dbPassword MySQL password (ignored for SQLite)
     */
    public DatabaseManager(StorageType storageType, String dbHost, int dbPort, String dbName, String dbUser, String dbPassword) {
        this.storageType = storageType;
        this.dbHost = dbHost;
        this.dbPort = dbPort;
        this.dbName = dbName;
        this.dbUser = dbUser;
        this.dbPassword = dbPassword;
        this.dbFile = "neoessentials" + File.separator + dbName + ".db";
    }
    
    /**
     * Initialize the database connection and create necessary tables
     * 
     * @return true if initialization was successful, false otherwise
     */
    public boolean initialize() {
        if (storageType == StorageType.JSON) {
            NeoEssentials.LOGGER.info("Using JSON storage, skipping database initialization");
            return false;
        }
        
        try {
            NeoEssentials.LOGGER.info("Initializing database connection pool for " + storageType);
            
            // Setup connection pool using HikariCP
            setupConnectionPool();
            
            if (dataSource != null) {
                // Create or upgrade schema
                createOrUpgradeSchema();
                
                initialized.set(true);
                NeoEssentials.LOGGER.info("Database initialized successfully");
                return true;
            } else {
                NeoEssentials.LOGGER.error("Failed to establish database connection");
                return false;
            }
        } catch (Exception e) {
            NeoEssentials.LOGGER.error("Error initializing database", e);
            return false;
        }
    }
    
    /**
     * Setup the connection pool using HikariCP
     */
    private void setupConnectionPool() {
        try {
            HikariConfig config = new HikariConfig();
            
            if (storageType == StorageType.SQLITE) {
                // Ensure the directory exists
                File dbDir = new File("neoessentials");
                if (!dbDir.exists()) {
                    dbDir.mkdirs();
                }
                
                // Load SQLite JDBC driver
                Class.forName("org.sqlite.JDBC");
                
                // Configure HikariCP for SQLite
                config.setJdbcUrl("jdbc:sqlite:" + dbFile);
                config.setDriverClassName("org.sqlite.JDBC");
                config.setMaximumPoolSize(1); // SQLite only supports one connection at a time
                
                // SQLite-specific pool properties
                config.addDataSourceProperty("pragmas", "foreign_keys(1)");
            
            } else if (storageType == StorageType.MYSQL) {
                // Load MySQL JDBC driver
                Class.forName("com.mysql.cj.jdbc.Driver");
                
                // Configure HikariCP for MySQL
                config.setJdbcUrl("jdbc:mysql://" + dbHost + ":" + dbPort + "/" + dbName);
                config.setDriverClassName("com.mysql.cj.jdbc.Driver");
                config.setUsername(dbUser);
                config.setPassword(dbPassword);
                
                // MySQL-specific pool properties
                config.addDataSourceProperty("cachePrepStmts", "true");
                config.addDataSourceProperty("prepStmtCacheSize", "250");
                config.addDataSourceProperty("prepStmtCacheSqlLimit", "2048");
                config.addDataSourceProperty("useServerPrepStmts", "true");
                config.addDataSourceProperty("useLocalSessionState", "true");
                config.addDataSourceProperty("rewriteBatchedStatements", "true");
                config.addDataSourceProperty("cacheResultSetMetadata", "true");
                config.addDataSourceProperty("cacheServerConfiguration", "true");
                config.addDataSourceProperty("elideSetAutoCommits", "true");
                config.addDataSourceProperty("maintainTimeStats", "false");
                config.addDataSourceProperty("autoReconnect", "true");
                config.addDataSourceProperty("useSSL", "false");
                
                // Set pool size based on expected load
                config.setMaximumPoolSize(10);
            }
            
            // Common pool settings
            config.setPoolName("NeoEssentialsPool");
            config.setMinimumIdle(1);
            config.setIdleTimeout(30000);
            config.setConnectionTimeout(10000);
            config.setMaxLifetime(1800000); // 30 minutes
            
            // Initialize the datasource
            dataSource = new HikariDataSource(config);
            
            NeoEssentials.LOGGER.info("Database connection pool initialized");
            
        } catch (ClassNotFoundException e) {
            NeoEssentials.LOGGER.error("Database driver not found", e);
        } catch (Exception e) {
            NeoEssentials.LOGGER.error("Error setting up connection pool", e);
        }
    }
    
    /**
     * Create or upgrade the database schema
     */
    private void createOrUpgradeSchema() {
        try (Connection conn = getConnection()) {
            // Check if schema version table exists
            boolean hasVersionTable = false;
            try (Statement stmt = conn.createStatement()) {
                ResultSet rs = stmt.executeQuery(
                    "SELECT name FROM sqlite_master WHERE type='table' AND name='schema_version'"
                );
                hasVersionTable = rs.next();
            } catch (SQLException e) {
                // MySQL doesn't have sqlite_master, so we'll handle the exception differently
                try {
                    ResultSet rs = conn.getMetaData().getTables(null, null, "schema_version", null);
                    hasVersionTable = rs.next();
                } catch (SQLException ex) {
                    NeoEssentials.LOGGER.error("Error checking for schema version table", ex);
                }
            }
            
            int currentVersion = 0;
            
            if (!hasVersionTable) {
                // Create schema version table
                try (Statement stmt = conn.createStatement()) {
                    stmt.execute("CREATE TABLE schema_version (version INTEGER NOT NULL)");
                    stmt.execute("INSERT INTO schema_version (version) VALUES (0)");
                }
            } else {
                // Get current schema version
                try (Statement stmt = conn.createStatement()) {
                    ResultSet rs = stmt.executeQuery("SELECT version FROM schema_version");
                    if (rs.next()) {
                        currentVersion = rs.getInt("version");
                    }
                }
            }
            
            // Apply schema updates as needed
            if (currentVersion < 1) {
                applySchemaV1(conn);
                currentVersion = 1;
            }
            
            // Update schema version
            try (PreparedStatement stmt = conn.prepareStatement("UPDATE schema_version SET version = ?")) {
                stmt.setInt(1, CURRENT_SCHEMA_VERSION);
                stmt.executeUpdate();
            }
            
            NeoEssentials.LOGGER.info("Database schema initialized to version " + CURRENT_SCHEMA_VERSION);
            
        } catch (SQLException e) {
            NeoEssentials.LOGGER.error("Error creating/upgrading database schema", e);
        }
    }
    
    /**
     * Apply schema version 1 updates
     * 
     * @param conn The database connection
     * @throws SQLException If a database error occurs
     */
    private void applySchemaV1(Connection conn) throws SQLException {
        NeoEssentials.LOGGER.info("Applying database schema version 1");
        
        try (Statement stmt = conn.createStatement()) {
            // Create player data table
            stmt.execute("CREATE TABLE IF NOT EXISTS player_data (" +
                    "uuid VARCHAR(36) PRIMARY KEY, " +
                    "name VARCHAR(16) NOT NULL, " +
                    "balance DOUBLE DEFAULT 0.0, " + 
                    "last_login BIGINT DEFAULT 0" +
                    ")");
            
            // Create homes table
            stmt.execute("CREATE TABLE IF NOT EXISTS homes (" +
                    "id INTEGER PRIMARY KEY " + (storageType == StorageType.SQLITE ? "AUTOINCREMENT" : "AUTO_INCREMENT") + ", " +
                    "owner_uuid VARCHAR(36) NOT NULL, " +
                    "name VARCHAR(32) NOT NULL, " +
                    "dimension VARCHAR(64) NOT NULL, " +
                    "x DOUBLE NOT NULL, " +
                    "y DOUBLE NOT NULL, " +
                    "z DOUBLE NOT NULL, " +
                    "yaw FLOAT NOT NULL, " +
                    "pitch FLOAT NOT NULL, " +
                    "UNIQUE (owner_uuid, name)" +
                    ")");
            
            // Create warps table
            stmt.execute("CREATE TABLE IF NOT EXISTS warps (" +
                    "name VARCHAR(32) PRIMARY KEY, " +
                    "dimension VARCHAR(64) NOT NULL, " +
                    "x DOUBLE NOT NULL, " +
                    "y DOUBLE NOT NULL, " +
                    "z DOUBLE NOT NULL, " +
                    "yaw FLOAT NOT NULL, " +
                    "pitch FLOAT NOT NULL" +
                    ")");
            
            // Create kits table
            stmt.execute("CREATE TABLE IF NOT EXISTS kits (" +
                    "name VARCHAR(32) PRIMARY KEY, " +
                    "cooldown INTEGER NOT NULL, " +
                    "items TEXT NOT NULL" +
                    ")");
            
            // Create kit usage table
            stmt.execute("CREATE TABLE IF NOT EXISTS kit_usage (" +
                    "uuid VARCHAR(36) NOT NULL, " +
                    "kit_name VARCHAR(32) NOT NULL, " +
                    "last_used BIGINT NOT NULL, " +
                    "PRIMARY KEY (uuid, kit_name)" +
                    ")");
            
            // Create transaction history table (new in v1)
            stmt.execute("CREATE TABLE IF NOT EXISTS transactions (" +
                    "id INTEGER PRIMARY KEY " + (storageType == StorageType.SQLITE ? "AUTOINCREMENT" : "AUTO_INCREMENT") + ", " +
                    "uuid VARCHAR(36) NOT NULL, " +
                    "type VARCHAR(16) NOT NULL, " +
                    "amount DOUBLE NOT NULL, " +
                    "balance_after DOUBLE NOT NULL, " +
                    "description TEXT, " +
                    "timestamp BIGINT NOT NULL" +
                    ")");
            
            // Create mail table (new in v1)
            stmt.execute("CREATE TABLE IF NOT EXISTS mail (" +
                    "id INTEGER PRIMARY KEY " + (storageType == StorageType.SQLITE ? "AUTOINCREMENT" : "AUTO_INCREMENT") + ", " +
                    "recipient_uuid VARCHAR(36) NOT NULL, " +
                    "sender_uuid VARCHAR(36), " +
                    "sender_name VARCHAR(36) NOT NULL, " +
                    "message TEXT NOT NULL, " +
                    "read BOOLEAN DEFAULT 0, " +
                    "timestamp BIGINT NOT NULL" +
                    ")");
                    
            // Create jails table (new in v1)
            stmt.execute("CREATE TABLE IF NOT EXISTS jails (" +
                    "name VARCHAR(32) PRIMARY KEY, " +
                    "dimension VARCHAR(64) NOT NULL, " +
                    "x DOUBLE NOT NULL, " +
                    "y DOUBLE NOT NULL, " +
                    "z DOUBLE NOT NULL, " +
                    "yaw FLOAT NOT NULL, " +
                    "pitch FLOAT NOT NULL" +
                    ")");
                    
            // Create jailed players table (new in v1)
            stmt.execute("CREATE TABLE IF NOT EXISTS jailed_players (" +
                    "uuid VARCHAR(36) PRIMARY KEY, " +
                    "jail_name VARCHAR(32) NOT NULL, " +
                    "duration INTEGER NOT NULL, " +
                    "reason TEXT, " +
                    "jailer_uuid VARCHAR(36), " +
                    "jail_time BIGINT NOT NULL, " +
                    "release_time BIGINT" +
                    ")");
                    
            // Create indexes for performance
            stmt.execute("CREATE INDEX IF NOT EXISTS idx_homes_owner_uuid ON homes (owner_uuid)");
            stmt.execute("CREATE INDEX IF NOT EXISTS idx_kit_usage_uuid ON kit_usage (uuid)");
            stmt.execute("CREATE INDEX IF NOT EXISTS idx_transactions_uuid ON transactions (uuid)");
            stmt.execute("CREATE INDEX IF NOT EXISTS idx_mail_recipient ON mail (recipient_uuid)");
        }
    }
    
    /**
     * Get a database connection from the pool
     * 
     * @return A database connection
     * @throws SQLException if a connection cannot be acquired
     */
    public Connection getConnection() throws SQLException {
        if (dataSource == null) {
            throw new SQLException("Database connection pool not initialized");
        }
        return dataSource.getConnection();
    }
    
    /**
     * Execute a database operation with automatic connection handling.
     * This pattern ensures connections are properly closed even if exceptions occur.
     *
     * @param <T> the return type of the operation
     * @param operation the database operation to perform
     * @return the result of the operation
     * @throws SQLException if a database error occurs
     */
    public <T> T executeOperation(DatabaseOperation<T> operation) throws SQLException {
        try (Connection conn = getConnection()) {
            return operation.execute(conn);
        }
    }
    
    /**
     * Execute a database operation that returns no result.
     *
     * @param operation the database operation to perform
     * @throws SQLException if a database error occurs
     */
    public void executeVoidOperation(DatabaseVoidOperation operation) throws SQLException {
        try (Connection conn = getConnection()) {
            operation.execute(conn);
        }
    }
    
    /**
     * Functional interface for database operations that return a result
     */
    @FunctionalInterface
    public interface DatabaseOperation<T> {
        T execute(Connection connection) throws SQLException;
    }
    
    /**
     * Functional interface for database operations that don't return a result
     */
    @FunctionalInterface
    public interface DatabaseVoidOperation {
        void execute(Connection connection) throws SQLException;
    }
    
    /**
     * Close the database connection pool
     */
    public void close() {
        if (shuttingDown.compareAndSet(false, true)) {
            if (dataSource != null && !dataSource.isClosed()) {
                NeoEssentials.LOGGER.info("Closing database connection pool");
                dataSource.close();
                NeoEssentials.LOGGER.info("Database connection pool closed");
            }
            initialized.set(false);
        }
    }
    
    /**
     * Check if the database connection is initialized
     * 
     * @return True if initialized, false otherwise
     */
    public boolean isInitialized() {
        return initialized.get();
    }
    
    /**
     * Get the storage type being used
     * 
     * @return The storage type
     */
    public StorageType getStorageType() {
        return storageType;
    }
    
    /**
     * Save a player's balance to the database
     * 
     * @param uuid The player's UUID
     * @param name The player's name
     * @param balance The player's balance
     * @return True if successful, false otherwise
     */
    public boolean savePlayerBalance(UUID uuid, String name, double balance) {
        if (!initialized.get() || storageType == StorageType.JSON) return false;
        
        try {
            return executeOperation(conn -> {
                String sql = "INSERT INTO player_data (uuid, name, balance) VALUES (?, ?, ?) " +
                        "ON " + (storageType == StorageType.SQLITE ? "CONFLICT" : "DUPLICATE KEY") + 
                        " UPDATE SET name = ?, balance = ?";
                        
                try (PreparedStatement stmt = conn.prepareStatement(sql)) {
                    stmt.setString(1, uuid.toString());
                    stmt.setString(2, name);
                    stmt.setDouble(3, balance);
                    stmt.setString(4, name);
                    stmt.setDouble(5, balance);
                    
                    return stmt.executeUpdate() > 0;
                }
            });
        } catch (SQLException e) {
            NeoEssentials.LOGGER.error("Error saving player balance", e);
            return false;
        }
    }
    
    /**
     * Record a player's transaction in the transaction history
     * 
     * @param uuid The player's UUID
     * @param type The transaction type (e.g., "deposit", "withdraw", "transfer")
     * @param amount The transaction amount
     * @param balanceAfter The balance after the transaction
     * @param description A description of the transaction
     * @return True if successful, false otherwise
     */
    public boolean recordTransaction(UUID uuid, String type, double amount, double balanceAfter, String description) {
        if (!initialized.get() || storageType == StorageType.JSON) return false;
        
        try {
            return executeOperation(conn -> {
                String sql = "INSERT INTO transactions (uuid, type, amount, balance_after, description, timestamp) " +
                        "VALUES (?, ?, ?, ?, ?, ?)";
                        
                try (PreparedStatement stmt = conn.prepareStatement(sql)) {
                    stmt.setString(1, uuid.toString());
                    stmt.setString(2, type);
                    stmt.setDouble(3, amount);
                    stmt.setDouble(4, balanceAfter);
                    stmt.setString(5, description);
                    stmt.setLong(6, System.currentTimeMillis());
                    
                    return stmt.executeUpdate() > 0;
                }
            });
        } catch (SQLException e) {
            NeoEssentials.LOGGER.error("Error recording transaction", e);
            return false;
        }
    }
    
    /**
     * Load all player balances from the database
     * 
     * @return Map of player UUIDs to balances
     */
    public Map<UUID, Double> loadAllBalances() {
        Map<UUID, Double> balances = new HashMap<>();
        
        if (!initialized.get() || storageType == StorageType.JSON) return balances;
        
        try {
            return executeOperation(conn -> {
                Map<UUID, Double> result = new HashMap<>();
                String sql = "SELECT uuid, balance FROM player_data";
                
                try (Statement stmt = conn.createStatement();
                     ResultSet rs = stmt.executeQuery(sql)) {
                    
                    while (rs.next()) {
                        String uuidStr = rs.getString("uuid");
                        double balance = rs.getDouble("balance");
                        try {
                            UUID uuid = UUID.fromString(uuidStr);
                            result.put(uuid, balance);
                        } catch (IllegalArgumentException e) {
                            NeoEssentials.LOGGER.error("Invalid UUID in database: " + uuidStr, e);
                        }
                    }
                }
                return result;
            });
        } catch (SQLException e) {
            NeoEssentials.LOGGER.error("Error loading player balances", e);
            return balances;
        }
    }
    
    /**
     * Get a player's transaction history
     * 
     * @param uuid The player's UUID
     * @param limit Maximum number of transactions to retrieve
     * @param offset Offset for pagination
     * @return List of transaction data
     */
    public Map<Integer, Map<String, Object>> getPlayerTransactions(UUID uuid, int limit, int offset) {
        Map<Integer, Map<String, Object>> transactions = new HashMap<>();
        
        if (!initialized.get() || storageType == StorageType.JSON) return transactions;
        
        try {
            return executeOperation(conn -> {
                Map<Integer, Map<String, Object>> result = new HashMap<>();
                String sql = "SELECT id, type, amount, balance_after, description, timestamp " +
                             "FROM transactions WHERE uuid = ? " +
                             "ORDER BY timestamp DESC LIMIT ? OFFSET ?";
                
                try (PreparedStatement stmt = conn.prepareStatement(sql)) {
                    stmt.setString(1, uuid.toString());
                    stmt.setInt(2, limit);
                    stmt.setInt(3, offset);
                    
                    try (ResultSet rs = stmt.executeQuery()) {
                        while (rs.next()) {
                            Map<String, Object> transaction = new HashMap<>();
                            transaction.put("id", rs.getInt("id"));
                            transaction.put("type", rs.getString("type"));
                            transaction.put("amount", rs.getDouble("amount"));
                            transaction.put("balanceAfter", rs.getDouble("balance_after"));
                            transaction.put("description", rs.getString("description"));
                            transaction.put("timestamp", rs.getLong("timestamp"));
                            
                            result.put(rs.getInt("id"), transaction);
                        }
                    }
                }
                return result;
            });
        } catch (SQLException e) {
            NeoEssentials.LOGGER.error("Error getting player transactions", e);
            return transactions;
        }
    }
    
    /**
     * Migrate data from one storage type to another
     * 
     * @param source Source database manager
     * @return True if migration was successful, false otherwise
     */
    public boolean migrateFrom(DatabaseManager source) {
        if (!initialized.get() || !source.isInitialized()) return false;
        
        try {
            // Migrate player data
            migratePlayerData(source);
            
            // Migrate homes
            migrateHomes(source);
            
            // Migrate warps
            migrateWarps(source);
            
            // Migrate kits
            migrateKits(source);
            
            // Migrate kit usage
            migrateKitUsage(source);
            
            // Migrate transactions if available
            migrateTransactions(source);
            
            // Migrate jails if available
            migrateJails(source);
            
            // Migrate jailed players if available
            migrateJailedPlayers(source);
            
            // Migrate mail if available
            migrateMail(source);
            
            return true;
        } catch (Exception e) {
            NeoEssentials.LOGGER.error("Error during data migration", e);
            return false;
        }
    }
    
    /**
     * Migrate player data from one database to another
     */
    private void migratePlayerData(DatabaseManager source) throws SQLException {
        NeoEssentials.LOGGER.info("Migrating player data...");
        
        // Get player data from source
        Map<String, Map<String, Object>> playerData = source.executeOperation(conn -> {
            Map<String, Map<String, Object>> data = new HashMap<>();
            String sql = "SELECT uuid, name, balance, last_login FROM player_data";
            
            try (Statement stmt = conn.createStatement();
                 ResultSet rs = stmt.executeQuery(sql)) {
                
                while (rs.next()) {
                    Map<String, Object> player = new HashMap<>();
                    String uuid = rs.getString("uuid");
                    player.put("name", rs.getString("name"));
                    player.put("balance", rs.getDouble("balance"));
                    player.put("last_login", rs.getLong("last_login"));
                    
                    data.put(uuid, player);
                }
            }
            return data;
        });
        
        // Insert into destination
        if (!playerData.isEmpty()) {
            executeVoidOperation(conn -> {
                String sql = "INSERT INTO player_data (uuid, name, balance, last_login) VALUES (?, ?, ?, ?) " +
                        "ON " + (storageType == StorageType.SQLITE ? "CONFLICT" : "DUPLICATE KEY") + 
                        " UPDATE SET name = ?, balance = ?, last_login = ?";
                
                try (PreparedStatement stmt = conn.prepareStatement(sql)) {
                    for (Map.Entry<String, Map<String, Object>> entry : playerData.entrySet()) {
                        String uuid = entry.getKey();
                        Map<String, Object> player = entry.getValue();
                        
                        stmt.setString(1, uuid);
                        stmt.setString(2, (String) player.get("name"));
                        stmt.setDouble(3, (Double) player.get("balance"));
                        stmt.setLong(4, (Long) player.get("last_login"));
                        stmt.setString(5, (String) player.get("name"));
                        stmt.setDouble(6, (Double) player.get("balance"));
                        stmt.setLong(7, (Long) player.get("last_login"));
                        
                        stmt.addBatch();
                    }
                    
                    int[] results = stmt.executeBatch();
                    NeoEssentials.LOGGER.info("Migrated " + results.length + " player records");
                }
            });
        }
    }
    
    /**
     * Migrate homes from one database to another
     */
    private void migrateHomes(DatabaseManager source) throws SQLException {
        // Implementation would be similar to migratePlayerData
        // but with the homes table schema
        NeoEssentials.LOGGER.info("Migrating homes...");
        
        // Get homes from source
        Map<Integer, Map<String, Object>> homes = source.executeOperation(conn -> {
            Map<Integer, Map<String, Object>> data = new HashMap<>();
            String sql = "SELECT id, owner_uuid, name, dimension, x, y, z, yaw, pitch FROM homes";
            
            try (Statement stmt = conn.createStatement();
                 ResultSet rs = stmt.executeQuery(sql)) {
                
                while (rs.next()) {
                    Map<String, Object> home = new HashMap<>();
                    int id = rs.getInt("id");
                    home.put("owner_uuid", rs.getString("owner_uuid"));
                    home.put("name", rs.getString("name"));
                    home.put("dimension", rs.getString("dimension"));
                    home.put("x", rs.getDouble("x"));
                    home.put("y", rs.getDouble("y"));
                    home.put("z", rs.getDouble("z"));
                    home.put("yaw", rs.getFloat("yaw"));
                    home.put("pitch", rs.getFloat("pitch"));
                    
                    data.put(id, home);
                }
            }
            return data;
        });
        
        // Insert into destination
        if (!homes.isEmpty()) {
            executeVoidOperation(conn -> {
                String sql = "INSERT INTO homes (owner_uuid, name, dimension, x, y, z, yaw, pitch) VALUES (?, ?, ?, ?, ?, ?, ?, ?) " +
                        "ON " + (storageType == StorageType.SQLITE ? "CONFLICT(owner_uuid, name)" : "DUPLICATE KEY") + 
                        " UPDATE SET dimension = ?, x = ?, y = ?, z = ?, yaw = ?, pitch = ?";
                
                try (PreparedStatement stmt = conn.prepareStatement(sql)) {
                    for (Map<String, Object> home : homes.values()) {
                        stmt.setString(1, (String) home.get("owner_uuid"));
                        stmt.setString(2, (String) home.get("name"));
                        stmt.setString(3, (String) home.get("dimension"));
                        stmt.setDouble(4, (Double) home.get("x"));
                        stmt.setDouble(5, (Double) home.get("y"));
                        stmt.setDouble(6, (Double) home.get("z"));
                        stmt.setFloat(7, (Float) home.get("yaw"));
                        stmt.setFloat(8, (Float) home.get("pitch"));
                        stmt.setString(9, (String) home.get("dimension"));
                        stmt.setDouble(10, (Double) home.get("x"));
                        stmt.setDouble(11, (Double) home.get("y"));
                        stmt.setDouble(12, (Double) home.get("z"));
                        stmt.setFloat(13, (Float) home.get("yaw"));
                        stmt.setFloat(14, (Float) home.get("pitch"));
                        
                        stmt.addBatch();
                    }
                    
                    int[] results = stmt.executeBatch();
                    NeoEssentials.LOGGER.info("Migrated " + results.length + " home records");
                }
            });
        }
    }
    
