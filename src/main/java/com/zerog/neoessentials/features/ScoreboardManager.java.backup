package com.zerog.neoessentials.features;

import com.zerog.neoessentials.util.DebugUtil;
import net.minecraft.server.level.ServerPlayer;
import net.minecraft.server.MinecraftServer;
import net.minecraft.network.chat.Component;
import net.minecraft.network.protocol.game.*;
import net.minecraft.world.scores.*;
import net.minecraft.world.scores.criteria.ObjectiveCriteria;
import net.neoforged.neoforge.common.NeoForge;
import net.neoforged.neoforge.event.entity.player.PlayerEvent;
import net.neoforged.neoforge.event.server.ServerStartedEvent;
import net.neoforged.bus.api.SubscribeEvent;
import java.io.FileReader;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.ScheduledExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;

/**
 * Professional ScoreboardManager - Like FeatherBoard, ScoreBoard-r, or TAB plugin
 * 
 * Features:
 * - Proper Minecraft scoreboard system usage (no action bar hacks)
 * - Priority-based layout system with permission and placeholder conditions
 * - Animation support for titles and content
 * - Configurable update intervals for performance
 * - Full placeholder integration
 * - Conditional line display
 * - Per-player scoreboard management
 * - Professional scoreboard display like Spigot plugins
 */
public class ScoreboardManager {
    
    // Professional scoreboard management
    private final Map<UUID, Objective> playerObjectives = new ConcurrentHashMap<>();
    private final Map<UUID, ScoreboardDisplayData> playerDisplayData = new ConcurrentHashMap<>();
    private final Map<UUID, Long> playerJoinTime = new ConcurrentHashMap<>();
    private final Map<UUID, Long> lastUpdateTime = new ConcurrentHashMap<>();
    
    // Animation and config management
    private final ScheduledExecutorService scheduler = Executors.newScheduledThreadPool(2);
    private long lastConfigReload = 0;
    private final long CONFIG_RELOAD_INTERVAL = 30000; // 30 seconds
    private long updateInterval = 1000; // 1 second default
    
    // Configuration
    private static ScoreboardManager instance;
    private MinecraftServer server;
    private com.zerog.neoessentials.config.TablistConfig config;
    private boolean enableScoreboard = true;
    
    // Animation state
    private long animationStartTime = System.currentTimeMillis();

    public ScoreboardManager() {
        DebugUtil.debugLog("[ScoreboardManager] Initializing Professional Scoreboard System");
        instance = this;
        NeoForge.EVENT_BUS.register(this);
        loadConfig();
        startUpdateScheduler();
        DebugUtil.debugLog("[ScoreboardManager] Professional Scoreboard System ready - Update interval: " + updateInterval + "ms");
    }
    
    /**
     * Scoreboard display data for each player
     */
    private static class ScoreboardDisplayData {
        String currentTitle = "";
        List<String> currentLines = new ArrayList<>();
        String layoutName = "default";
        long lastAnimationUpdate = 0;
        Map<String, Integer> animationFrames = new HashMap<>();
        
        void reset() {
            currentTitle = "";
            currentLines.clear();
            layoutName = "default";
            lastAnimationUpdate = 0;
            animationFrames.clear();
        }
    }
    
    /**
     * Start the professional update scheduler
     */
    private void startUpdateScheduler() {
        // Main scoreboard update task
        scheduler.scheduleAtFixedRate(() -> {
            try {
                if (enableScoreboard && server != null) {
                    updateAllScoreboards();
                }
            } catch (Exception e) {
                DebugUtil.errorLog("[ScoreboardManager] Error in scoreboard update task: " + e.getMessage());
            }
        }, updateInterval, updateInterval, TimeUnit.MILLISECONDS);
        
        // Config reload check task
        scheduler.scheduleAtFixedRate(() -> {
            try {
                long now = System.currentTimeMillis();
                if (now - lastConfigReload > CONFIG_RELOAD_INTERVAL) {
                    reloadConfigIfNeeded();
                    lastConfigReload = now;
                }
            } catch (Exception e) {
                DebugUtil.errorLog("[ScoreboardManager] Error in config reload task: " + e.getMessage());
            }
        }, CONFIG_RELOAD_INTERVAL, CONFIG_RELOAD_INTERVAL, TimeUnit.MILLISECONDS);
    }
    
    /**
     * Reload configuration if files have changed
     */
    private void reloadConfigIfNeeded() {
        try {
            java.io.File configFile = new java.io.File("config/neoessentials/scoreboard.json");
            if (configFile.exists()) {
                loadConfig();
                DebugUtil.debugLog("[ScoreboardManager] Configuration reloaded");
            }
        } catch (Exception e) {
            DebugUtil.debugLog("[ScoreboardManager] Error checking config reload: " + e.getMessage());
        }
    }

    /**
     * Enhanced config loading for professional scoreboard system
     */
    private void loadConfig() {
        try {
            String configPath = "config/neoessentials/scoreboard.json";
            java.io.File configFile = new java.io.File(configPath);
            
            if (!configFile.exists()) {
                DebugUtil.debugLog("[ScoreboardManager] scoreboard.json not found, using default configuration");
                createDefaultConfig();
                return;
            }
            
            com.google.gson.GsonBuilder gsonBuilder = new com.google.gson.GsonBuilder();
            com.google.gson.Gson gson = gsonBuilder.setPrettyPrinting().create();
            
            try (FileReader reader = new FileReader(configFile)) {
                com.zerog.neoessentials.config.TablistConfig loadedConfig = gson.fromJson(reader, 
                    com.zerog.neoessentials.config.TablistConfig.class);
                
                if (loadedConfig != null && loadedConfig.scoreboard != null) {
                    this.config = loadedConfig;
                    enableScoreboard = config.scoreboard.enabled;
                    updateInterval = Math.max(500, config.scoreboard.updateInterval * 50); // Convert ticks to ms, min 500ms
                    
                    DebugUtil.debugLog("[ScoreboardManager] Configuration loaded successfully - " + 
                                      "Enabled: " + enableScoreboard + 
                                      ", Update interval: " + updateInterval + "ms" +
                                      ", Layouts: " + (config.scoreboard.layouts != null ? config.scoreboard.layouts.size() : 0));
                } else {
                    DebugUtil.warnLog("[ScoreboardManager] Invalid config structure, using defaults");
                    createDefaultConfig();
                }
            }
        } catch (Exception e) {
            DebugUtil.warnLog("[ScoreboardManager] Error loading config, using defaults: " + e.getMessage());
            createDefaultConfig();
        }
    }
    
    /**
     * Create default configuration when none exists
     */
    private void createDefaultConfig() {
        try {
            enableScoreboard = true;
            updateInterval = 1000;
            
            // Create a default config structure
            config = new com.zerog.neoessentials.config.TablistConfig();
            config.scoreboard = new com.zerog.neoessentials.config.TablistConfig.ScoreboardSection();
            config.scoreboard.enabled = true;
            config.scoreboard.updateInterval = 20; // 20 ticks = 1 second
            config.scoreboard.maxLines = 15;
            config.scoreboard.title = "&6&lNeoEssentials Server";
            
            // Create default layout
            com.zerog.neoessentials.config.TablistConfig.Layout defaultLayout = 
                new com.zerog.neoessentials.config.TablistConfig.Layout();
            defaultLayout.priority = 1;
            defaultLayout.conditionType = "default";
            defaultLayout.title = "&7&lPLAYER INFO";
            defaultLayout.lines = Arrays.asList(
                "&7&m─────────────────────",
                "&7&l● PLAYER INFO ●",
                "&7&m─────────────────────",
                "",
                "&f▶ &7Player: &f{player_name}",
                "&f▶ &7Level: &a{player_level}",
                "&f▶ &7Health: &c{player_health}&7/&c{player_max_health}",
                "&f▶ &7Food: &6{player_food}",
                "",
                "&f▶ &7Location:",
                "&f  &7World: &e{player_world}",
                "&f  &7X: &e{player_x} &7Y: &e{player_y} &7Z: &e{player_z}",
                "",
                "&f▶ &7Online: &e{server_players}&7/&e{server_max_players}",
                "&f▶ &7Time: &f{time}",
                "&7&m─────────────────────"
            );
            
            config.scoreboard.layouts = Arrays.asList(defaultLayout);
            
            DebugUtil.debugLog("[ScoreboardManager] Created default configuration");
        } catch (Exception e) {
            DebugUtil.errorLog("[ScoreboardManager] Error creating default config: " + e.getMessage());
        }
    }

    @SubscribeEvent
    public void onServerStarted(ServerStartedEvent event) {
        this.server = event.getServer();
        DebugUtil.debugLog("[ScoreboardManager] Server started, ready for scoreboard management");
    }

    @SubscribeEvent
    public void onPlayerJoin(PlayerEvent.PlayerLoggedInEvent event) {
        if (event.getEntity() instanceof ServerPlayer player) {
            DebugUtil.debugLog("[ScoreboardManager] Player joined: " + player.getGameProfile().getName());
            playerJoinTime.put(player.getUUID(), System.currentTimeMillis());
            
            // Initialize scoreboard display data
            ScoreboardDisplayData displayData = new ScoreboardDisplayData();
            playerDisplayData.put(player.getUUID(), displayData);
            
            // Schedule scoreboard creation after a brief delay to ensure player is fully loaded
            scheduler.schedule(() -> {
                if (player.getServer() != null) {
                    createPlayerScoreboard(player);
                    updateScoreboard(player);
                }
            }, 1000, TimeUnit.MILLISECONDS);
        }
    }

    @SubscribeEvent
    public void onPlayerLeave(PlayerEvent.PlayerLoggedOutEvent event) {
        if (event.getEntity() instanceof ServerPlayer player) {
            cleanupPlayer(player);
        }
    }
    
    /**
     * Create professional scoreboard for player using proper Minecraft scoreboard system
     */
    private void createPlayerScoreboard(ServerPlayer player) {
        if (!enableScoreboard || player == null) return;
        
        try {
            UUID playerId = player.getUUID();
            
            // Clean up existing objective if present
            cleanupPlayerObjective(player);
            
            // Create new scoreboard objective
            String objectiveName = "neoessentials_" + playerId.toString().substring(0, 8);
            Scoreboard scoreboard = server.getScoreboard();
            
            // Remove existing objective if it exists
            Objective existingObjective = scoreboard.getObjective(objectiveName);
            if (existingObjective != null) {
                scoreboard.removeObjective(existingObjective);
            }
            
            // Create new objective with correct API
            Objective objective = scoreboard.addObjective(
                objectiveName, 
                ObjectiveCriteria.DUMMY, 
                Component.literal("NeoEssentials"), 
                ObjectiveCriteria.RenderType.INTEGER,
                false,
                null
            );
            
            // Set scoreboard to display on sidebar
            scoreboard.setDisplayObjective(DisplaySlot.SIDEBAR, objective);
            
            // Store objective reference
            playerObjectives.put(playerId, objective);
            
            DebugUtil.debugLog("[ScoreboardManager] Created scoreboard objective for " + player.getName().getString());
            
        } catch (Exception e) {
            DebugUtil.errorLog("[ScoreboardManager] Error creating scoreboard for " + player.getName().getString() + ": " + e.getMessage());
        }
    }
    
    /**
     * Update all player scoreboards
     */
    public void updateAllScoreboards() {
        if (server == null || !enableScoreboard) return;
        
        try {
            for (ServerPlayer player : server.getPlayerList().getPlayers()) {
                updateScoreboard(player);
            }
        } catch (Exception e) {
            DebugUtil.errorLog("[ScoreboardManager] Error updating all scoreboards: " + e.getMessage());
        }
    }
    
    /**
     * Update scoreboard for specific player - professional implementation
     */
    public void updateScoreboard(ServerPlayer player) {
        if (!enableScoreboard || player == null || config == null) return;
        
        try {
            UUID playerId = player.getUUID();
            
            // Check if we need to throttle updates for this player
            Long lastUpdate = lastUpdateTime.get(playerId);
            long now = System.currentTimeMillis();
            if (lastUpdate != null && (now - lastUpdate) < (updateInterval - 100)) {
                return; // Skip update to prevent spam
            }
            lastUpdateTime.put(playerId, now);
            
            // Get player's objective
            Objective objective = playerObjectives.get(playerId);
            if (objective == null) {
                createPlayerScoreboard(player);
                objective = playerObjectives.get(playerId);
                if (objective == null) return;
            }
            
            // Get display data
            ScoreboardDisplayData displayData = playerDisplayData.get(playerId);
            if (displayData == null) {
                displayData = new ScoreboardDisplayData();
                playerDisplayData.put(playerId, displayData);
            }
            
            // Find matching layout
            com.zerog.neoessentials.config.TablistConfig.Layout layout = findMatchingLayout(player);
            if (layout == null) return;
            
            // Process title with animations
            String title = processTitle(layout, player, displayData);
            
            // Process lines with placeholders and animations
            List<String> lines = processLines(layout, player, displayData);
            
            // Check if content changed
            if (!title.equals(displayData.currentTitle) || !lines.equals(displayData.currentLines)) {
                displayData.currentTitle = title;
                displayData.currentLines = new ArrayList<>(lines);
                
                // Update scoreboard display
                updateScoreboardDisplay(player, objective, title, lines);
            }
            
        } catch (Exception e) {
            DebugUtil.errorLog("[ScoreboardManager] Error updating scoreboard for " + player.getName().getString() + ": " + e.getMessage());
        }
    }
    
    /**
     * Find the highest priority matching layout for a player
     */
    private com.zerog.neoessentials.config.TablistConfig.Layout findMatchingLayout(ServerPlayer player) {
        if (config.scoreboard == null || config.scoreboard.layouts == null) return null;
        
        com.zerog.neoessentials.config.TablistConfig.Layout bestMatch = null;
        int highestPriority = -1;
        
        for (com.zerog.neoessentials.config.TablistConfig.Layout layout : config.scoreboard.layouts) {
            if (layout.priority <= highestPriority) continue;
            
            if (matchesLayoutCondition(player, layout)) {
                bestMatch = layout;
                highestPriority = layout.priority;
            }
        }
        
        return bestMatch;
    }
    
    /**
     * Check if player matches layout condition
     */
    private boolean matchesLayoutCondition(ServerPlayer player, com.zerog.neoessentials.config.TablistConfig.Layout layout) {
        String conditionType = layout.conditionType != null ? layout.conditionType.toLowerCase() : "default";
        String condition = layout.condition != null ? layout.condition : "";
        
        switch (conditionType) {
            case "permission":
                return hasPermission(player, condition);
            case "placeholder":
                return checkPlaceholderCondition(player, condition);
            case "default":
            default:
                return true;
        }
    }
    
    /**
     * Check placeholder-based condition
     */
    private boolean checkPlaceholderCondition(ServerPlayer player, String condition) {
        if (condition == null || !condition.contains(":")) return false;
        
        String[] parts = condition.split(":", 2);
        String placeholderName = parts[0];
        String expectedValue = parts[1];
        
        String actualValue = processPlaceholders("{" + placeholderName + "}", player);
        actualValue = actualValue.replace("§", "").replace("&", ""); // Strip color codes
        
        return expectedValue.equals(actualValue);
    }
    
    /**
     * Process title with animations
     */
    private String processTitle(com.zerog.neoessentials.config.TablistConfig.Layout layout, 
                               ServerPlayer player, ScoreboardDisplayData displayData) {
        String title = layout.title != null ? layout.title : config.scoreboard.title;
        
        // Check for title animations
        if (config.scoreboard.titleAnimations != null && config.scoreboard.titleAnimations.enabled) {
            String animatedTitle = getAnimatedTitle();
            if (animatedTitle != null) {
                title = animatedTitle;
            }
        }
        
        // Process placeholders
        title = processPlaceholders(title, player);
        
        // Limit title length (Minecraft limitation)
        if (title.length() > 128) {
            title = title.substring(0, 125) + "...";
        }
        
        return title.replace('&', '§');
    }
    
    /**
     * Process lines with placeholders and animations
     */
    private List<String> processLines(com.zerog.neoessentials.config.TablistConfig.Layout layout, 
                                     ServerPlayer player, ScoreboardDisplayData displayData) {
        List<String> processedLines = new ArrayList<>();
        
        if (layout.lines == null || layout.lines.isEmpty()) return processedLines;
        
        for (String line : layout.lines) {
            // Skip empty lines that are just whitespace
            if (line.trim().isEmpty()) {
                processedLines.add(" "); // Add space to maintain line spacing
                continue;
            }
            
            // Process conditional logic
            if (line.contains("${") && line.contains("}")) {
                line = processConditionalLogic(line, player);
            }
            
            // Process animations
            line = processAnimations(line, player, displayData);
            
            // Process placeholders
            String processedLine = processPlaceholders(line, player);
            
            // Limit line length
            if (processedLine.length() > 40) {
                processedLine = processedLine.substring(0, 37) + "...";
            }
            
            processedLines.add(processedLine.replace('&', '§'));
        }
        
        // Limit to max lines
        int maxLines = config.scoreboard.maxLines > 0 ? config.scoreboard.maxLines : 15;
        if (processedLines.size() > maxLines) {
            processedLines = processedLines.subList(0, maxLines);
        }
        
        return processedLines;
    }

    /**
     * Update the actual scoreboard display - simplified for compatibility
     */
    private void updateScoreboardDisplay(ServerPlayer player, Objective objective, String title, List<String> lines) {
        try {
            Scoreboard scoreboard = server.getScoreboard();
            
            // Update title
            objective.setDisplayName(Component.literal(title));
            
            // Set display location
            scoreboard.setDisplayObjective(DisplaySlot.SIDEBAR, objective);
            
            // Clear all existing scores by creating a new objective
            String oldName = objective.getName();
            scoreboard.removeObjective(objective);
            
            // Create fresh objective
            Objective newObjective = scoreboard.addObjective(
                oldName, 
                ObjectiveCriteria.DUMMY, 
                Component.literal(title), 
                ObjectiveCriteria.RenderType.INTEGER,
                false,
                null
            );
            
            // Set new objective to sidebar
            scoreboard.setDisplayObjective(DisplaySlot.SIDEBAR, newObjective);
            
            // Update the stored objective reference
            playerObjectives.put(player.getUUID(), newObjective);
            
            // Add new lines (reverse order - Minecraft displays from bottom to top)
            int score = lines.size();
            for (String line : lines) {
                if (line.trim().isEmpty()) {
                    // Create unique empty line
                    String emptyLine = " ".repeat(Math.max(1, 16 - score));
                    ScoreHolder holder = ScoreHolder.forNameOnly(emptyLine);
                    ScoreAccess scoreAccess = scoreboard.getOrCreatePlayerScore(holder, newObjective);
                    scoreAccess.set(score);
                } else {
                    // Ensure line is unique (Minecraft requirement)
                    String uniqueLine = ensureUniqueScoreboardLine(line, lines, lines.indexOf(line));
                    ScoreHolder holder = ScoreHolder.forNameOnly(uniqueLine);
                    ScoreAccess scoreAccess = scoreboard.getOrCreatePlayerScore(holder, newObjective);
                    scoreAccess.set(score);
                }
                score--;
            }
            
        } catch (Exception e) {
            DebugUtil.debugLog("[ScoreboardManager] Error updating scoreboard display: " + e.getMessage());
        }
    }
    
    /**
     * Ensure scoreboard line is unique (Minecraft requirement)
     */
    private String ensureUniqueScoreboardLine(String line, List<String> allLines, int index) {
        String uniqueLine = line;
        
        // Check if this line appears elsewhere
        for (int i = 0; i < allLines.size(); i++) {
            if (i != index && allLines.get(i).equals(line)) {
                // Make it unique by adding invisible characters
                uniqueLine = line + "§r".repeat(index + 1);
                break;
            }
        }
        
        return uniqueLine;
    }
    
    /**
     * Get animated title frame
     */
    private String getAnimatedTitle() {
        if (config.scoreboard.titleAnimations == null || 
            config.scoreboard.titleAnimations.frames == null || 
            config.scoreboard.titleAnimations.frames.isEmpty()) {
            return null;
        }
        
        List<String> frames = config.scoreboard.titleAnimations.frames;
        double duration = config.scoreboard.titleAnimations.duration * 1000; // Convert to milliseconds
        
        long currentTime = System.currentTimeMillis() - animationStartTime;
        int frameIndex = (int) ((currentTime / duration) % frames.size());
        
        return frames.get(frameIndex);
    }
    
    /**
     * Process animations in lines
     */
    private String processAnimations(String line, ServerPlayer player, ScoreboardDisplayData displayData) {
        if (config.scoreboard.animations == null || !config.scoreboard.animations.enabled) {
            return line;
        }
        
        // Look for animation placeholders like {animation:health_indicator}
        java.util.regex.Pattern pattern = java.util.regex.Pattern.compile("\\{animation:([^}]+)\\}");
        java.util.regex.Matcher matcher = pattern.matcher(line);
        
        String result = line;
        while (matcher.find()) {
            String animationId = matcher.group(1);
            String animationFrame = getAnimationFrame(animationId, player, displayData);
            if (animationFrame != null) {
                result = result.replace("{animation:" + animationId + "}", animationFrame);
            }
        }
        
        return result;
    }
    
    /**
     * Get current frame for an animation sequence
     */
    private String getAnimationFrame(String animationId, ServerPlayer player, ScoreboardDisplayData displayData) {
        if (config.scoreboard.animations.sequences == null) return null;
        
        for (com.zerog.neoessentials.config.TablistConfig.AnimationSequence sequence : config.scoreboard.animations.sequences) {
            if (!animationId.equals(sequence.id)) continue;
            
            // Check conditions for this animation
            if (!shouldShowAnimation(sequence, player)) continue;
            
            List<String> frames = sequence.frames;
            if (frames == null || frames.isEmpty()) continue;
            
            // Get or initialize frame index for this animation
            Integer currentFrame = displayData.animationFrames.get(animationId);
            if (currentFrame == null) {
                currentFrame = 0;
            }
            
            // Check if it's time to advance frame
            long now = System.currentTimeMillis();
            if (now - displayData.lastAnimationUpdate > (sequence.duration * 1000)) {
                currentFrame = (currentFrame + 1) % frames.size();
                displayData.animationFrames.put(animationId, currentFrame);
                displayData.lastAnimationUpdate = now;
            }
            
            return frames.get(currentFrame);
        }
        
        return null;
    }
    
    /**
     * Check if animation should be shown based on conditions
     */
    private boolean shouldShowAnimation(com.zerog.neoessentials.config.TablistConfig.AnimationSequence sequence, ServerPlayer player) {
        if (sequence.id.equals("health_indicator")) {
            return player.getHealth() < 6.0f;
        }
        // Add more conditions as needed
        return true;
    }
    
    /**
     * Process conditional logic in lines
     */
    private String processConditionalLogic(String line, ServerPlayer player) {
        if (config.scoreboard.conditional_logic == null) return line;
        
        // Look for ${condition_name} patterns
        java.util.regex.Pattern pattern = java.util.regex.Pattern.compile("\\$\\{([^}]+)\\}");
        java.util.regex.Matcher matcher = pattern.matcher(line);
        
        String result = line;
        while (matcher.find()) {
            String conditionName = matcher.group(1);
            String conditionLogic = config.scoreboard.conditional_logic.get(conditionName);
            
            if (conditionLogic != null) {
                boolean conditionMet = evaluateCondition(conditionLogic, player);
                String replacement = conditionMet ? "&a✓" : "&c✗";
                result = result.replace("${" + conditionName + "}", replacement);
            }
        }
        
        return result;
    }
    
    /**
     * Evaluate conditional logic expressions
     */
    private boolean evaluateCondition(String condition, ServerPlayer player) {
        try {
            // Handle permission checks
            if (condition.startsWith("permission:")) {
                String permission = condition.substring(11);
                return hasPermission(player, permission);
            }
            
            // Handle health checks
            if (condition.contains("health < 6")) {
                return player.getHealth() < 6.0f;
            }
            
            // Handle food checks
            if (condition.contains("food < 6")) {
                return player.getFoodData().getFoodLevel() < 6;
            }
            
            // Handle FTB checks
            if (condition.contains("ftb_has_team == true")) {
                String teamPlaceholder = processPlaceholders("{ftb_has_team}", player);
                return "true".equals(teamPlaceholder.replace("§", "").replace("&", ""));
            }
            
            if (condition.contains("ftb_has_rank == true")) {
                String rankPlaceholder = processPlaceholders("{ftb_has_rank}", player);
                return "true".equals(rankPlaceholder.replace("§", "").replace("&", ""));
            }
            
        } catch (Exception e) {
            DebugUtil.debugLog("[ScoreboardManager] Error evaluating condition '" + condition + "': " + e.getMessage());
        }
        
        return false;
    }
    
    /**
     * Check if player has permission
     */
    private boolean hasPermission(ServerPlayer player, String permission) {
        try {
            com.zerog.neoessentials.permissions.CustomPermissionsManager permMgr = 
                com.zerog.neoessentials.permissions.CustomPermissionsManager.getInstance();
            return permMgr.hasPermission(player, permission);
        } catch (Exception e) {
            DebugUtil.debugLog("[ScoreboardManager] Error checking permission: " + e.getMessage());
            return false;
        }
    }

    /**
     * Process placeholders in text with full NeoEssentials integration
     */
    private String processPlaceholders(String text, ServerPlayer player) {
        if (text == null || text.isEmpty()) return "";
        
        try {
            // Use PlaceholderManager for full integration
            com.zerog.neoessentials.placeholders.PlaceholderManager placeholderMgr = 
                com.zerog.neoessentials.placeholders.PlaceholderManager.getInstance();
            
            return placeholderMgr.processPlaceholders(text, player);
        } catch (Exception e) {
            DebugUtil.debugLog("[ScoreboardManager] Error with PlaceholderManager, using fallback: " + e.getMessage());
            return processFallbackPlaceholders(text, player);
        }
    }
    
    /**
     * Fallback placeholder processing
     */
    private String processFallbackPlaceholders(String text, ServerPlayer player) {
        String result = text
            .replace("{player_name}", player.getName().getString())
            .replace("{player_level}", String.valueOf(player.experienceLevel))
            .replace("{player_health}", String.valueOf((int)player.getHealth()))
            .replace("{player_max_health}", String.valueOf((int)player.getMaxHealth()))
            .replace("{player_food}", String.valueOf(player.getFoodData().getFoodLevel()))
            .replace("{player_x}", String.valueOf((int)player.getX()))
            .replace("{player_y}", String.valueOf((int)player.getY()))
            .replace("{player_z}", String.valueOf((int)player.getZ()))
            .replace("{player_world}", player.level().dimension().location().getPath())
            .replace("{player_ping}", String.valueOf(player.connection.latency()));
        
        // Server placeholders
        if (server != null) {
            result = result
                .replace("{server_players}", String.valueOf(server.getPlayerCount()))
                .replace("{server_max_players}", String.valueOf(server.getMaxPlayers()));
        }
        
        // Time placeholders
        java.time.LocalDateTime now = java.time.LocalDateTime.now();
        result = result
            .replace("{time}", now.format(java.time.format.DateTimeFormatter.ofPattern("HH:mm:ss")))
            .replace("{date}", now.format(java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd")))
            .replace("{datetime}", now.format(java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss")));
        
        return result;
    }
    
    /**
     * Clean up player scoreboard data
     */
    public void cleanupPlayer(ServerPlayer player) {
        if (player == null) return;
        
        try {
            UUID playerId = player.getUUID();
            
            // Clean up objective
            cleanupPlayerObjective(player);
            
            // Remove from data structures
            playerDisplayData.remove(playerId);
            playerJoinTime.remove(playerId);
            lastUpdateTime.remove(playerId);
            
            DebugUtil.debugLog("[ScoreboardManager] Cleaned up scoreboard for " + player.getName().getString());
        } catch (Exception e) {
            DebugUtil.errorLog("[ScoreboardManager] Error cleaning up player scoreboard: " + e.getMessage());
        }
    }
    
    /**
     * Clean up player's scoreboard objective
     */
    private void cleanupPlayerObjective(ServerPlayer player) {
        try {
            UUID playerId = player.getUUID();
            Objective objective = playerObjectives.remove(playerId);
            
            if (objective != null && server != null) {
                Scoreboard scoreboard = server.getScoreboard();
                
                // Clear sidebar display for this player
                player.connection.send(new ClientboundSetDisplayObjectivePacket(DisplaySlot.SIDEBAR, null));
                
                // Remove objective
                scoreboard.removeObjective(objective);
            }
        } catch (Exception e) {
            DebugUtil.debugLog("[ScoreboardManager] Error cleaning up objective: " + e.getMessage());
        }
    }
    
    /**
     * Reload configuration and update all scoreboards
     */
    public void reloadConfig() {
        try {
            DebugUtil.debugLog("[ScoreboardManager] Reloading configuration...");
            loadConfig();
            
            // Update all active scoreboards
            updateAllScoreboards();
            
            DebugUtil.debugLog("[ScoreboardManager] Configuration reloaded successfully");
        } catch (Exception e) {
            DebugUtil.errorLog("[ScoreboardManager] Error reloading config: " + e.getMessage());
        }
    }
    
    /**
     * Toggle scoreboard for a specific player
     */
    public void toggleScoreboard(ServerPlayer player) {
        try {
            UUID playerId = player.getUUID();
            ScoreboardDisplayData displayData = playerDisplayData.get(playerId);
            
            if (displayData != null) {
                // Player has scoreboard, remove it
                cleanupPlayerObjective(player);
                playerDisplayData.remove(playerId);
                DebugUtil.debugLog("[ScoreboardManager] Disabled scoreboard for " + player.getName().getString());
            } else {
                // Player doesn't have scoreboard, create one
                createPlayerScoreboard(player);
                updateScoreboard(player);
                DebugUtil.debugLog("[ScoreboardManager] Enabled scoreboard for " + player.getName().getString());
            }
        } catch (Exception e) {
            DebugUtil.errorLog("[ScoreboardManager] Error toggling scoreboard: " + e.getMessage());
        }
    }
    
    /**
     * Shutdown cleanup
     */
    public void shutdown() {
        try {
            DebugUtil.debugLog("[ScoreboardManager] Shutting down professional scoreboard system...");
            
            // Stop scheduler
            if (scheduler != null && !scheduler.isShutdown()) {
                scheduler.shutdown();
                if (!scheduler.awaitTermination(5, TimeUnit.SECONDS)) {
                    scheduler.shutdownNow();
                }
            }
            
            // Clean up all player scoreboards
            if (server != null) {
                for (ServerPlayer player : server.getPlayerList().getPlayers()) {
                    cleanupPlayer(player);
                }
            }
            
            // Clear data structures
            playerObjectives.clear();
            playerDisplayData.clear();
            playerJoinTime.clear();
            lastUpdateTime.clear();
            
            DebugUtil.debugLog("[ScoreboardManager] Professional scoreboard system shutdown complete");
        } catch (Exception e) {
            DebugUtil.errorLog("[ScoreboardManager] Error during shutdown: " + e.getMessage());
        }
    }
    
    /**
     * Get status information
     */
    public String getStatus() {
        return String.format("Professional Scoreboard System - Enabled: %s, Active players: %d, Update interval: %dms, Layouts: %d", 
                            enableScoreboard, 
                            playerDisplayData.size(), 
                            updateInterval,
                            config != null && config.scoreboard != null && config.scoreboard.layouts != null ? 
                                config.scoreboard.layouts.size() : 0);
    }
    
    /**
     * Force update scoreboard for player (for debugging)
     */
    public void forceUpdateScoreboard(ServerPlayer player) {
        try {
            lastUpdateTime.remove(player.getUUID()); // Remove throttling
            updateScoreboard(player);
            DebugUtil.debugLog("[ScoreboardManager] Force updated scoreboard for " + player.getName().getString());
        } catch (Exception e) {
            DebugUtil.errorLog("[ScoreboardManager] Error force updating scoreboard: " + e.getMessage());
        }
    }
    
    /**
     * Get singleton instance
     */
    public static ScoreboardManager getInstance() {
        return instance;
    }
}