{
  "_comment": "Shop System Configuration for NeoEssentials",
  "_version": "2.0.0",
  "_description": "Configuration for player shops, admin shops, and economy integration",
  
  "general": {
    "enabled": true,
    "allowAdminShops": true,
    "allowPlayerShops": true,
    "defaultTaxRate": 0.00,
    "allowHopperInteraction": false,
    "linkingItem": "minecraft:redstone",
    "shopLimit": {
      "default": 5,
      "vip": 10,
      "staff": 20,
      "admin": -1
    },
    "enableSigns": true,
    "enableChests": true,
    "enableGUI": true
  },
  
  "formats": {
    "shopHeader": ["[shop]", "[buy]", "[sell]"],
    "signLines": {
      "line1": "&6[Shop]",
      "line2": "&7Amount: &e{amount}",
      "line3": "&7Price: &a${price}",
      "line4": "&b{item_name}"
    },
    "amountLine": 2,
    "priceLine": 3,
    "itemLine": 4,
    "colors": {
      "available": "&a",
      "unavailable": "&c",
      "outOfStock": "&6",
      "adminShop": "&d"
    }
  },
  
  "validation": {
    "maxPrice": 1000000000.0,
    "minPrice": 0.01,
    "maxAmount": 3456,
    "minAmount": 1,
    "allowHexColors": true,
    "blacklistedItems": [
      "minecraft:bedrock",
      "minecraft:barrier",
      "minecraft:command_block",
      "minecraft:structure_block",
      "minecraft:jigsaw"
    ],
    "maxShopDistance": 100,
    "requireSafeLocation": true
  },
  
  "permissions": {
    "create": "neoessentials.shops.create",
    "admin": "neoessentials.shops.admin",
    "use": "neoessentials.shops.use",
    "buy": "neoessentials.shops.buy",
    "sell": "neoessentials.shops.sell",
    "destroy": "neoessentials.shops.destroy",
    "modify": "neoessentials.shops.modify",
    "list": "neoessentials.shops.list",
    "search": "neoessentials.shops.search",
    "teleport": "neoessentials.shops.teleport"
  },
  
  "economy": {
    "enableTransactionFees": false,
    "buyerFee": 0.0,
    "sellerFee": 0.05,
    "adminShopTax": 0.0,
    "enableBulkDiscounts": true,
    "bulkDiscountThreshold": 64,
    "bulkDiscountPercent": 0.1,
    "enableDynamicPricing": false,
    "priceFluctuation": 0.1
  },
  
  "gui": {
    "enabled": true,
    "title": "&6NeoEssentials Shops",
    "size": 54,
    "items": {
      "buy": {
        "material": "minecraft:emerald",
        "name": "&a&lBUY",
        "lore": [
          "&7Click to buy items",
          "&7from this shop",
          "",
          "&7Price: &a${price}",
          "&7Stock: &e{stock}"
        ]
      },
      "sell": {
        "material": "minecraft:gold_ingot",
        "name": "&6&lSELL",
        "lore": [
          "&7Click to sell items",
          "&7to this shop",
          "",
          "&7Price: &a${price}",
          "&7Space: &e{space}"
        ]
      },
      "info": {
        "material": "minecraft:paper",
        "name": "&b&lSHOP INFO",
        "lore": [
          "&7Owner: &e{owner}",
          "&7Created: &e{created}",
          "&7Location: &e{location}",
          "&7Type: &e{type}"
        ]
      },
      "back": {
        "material": "minecraft:arrow",
        "name": "&c&lBACK",
        "lore": [
          "&7Return to shop list"
        ]
      }
    },
    "sounds": {
      "buy": "minecraft:entity.experience_orb.pickup",
      "sell": "minecraft:entity.experience_orb.pickup",
      "error": "minecraft:entity.villager.no",
      "click": "minecraft:ui.button.click"
    }
  },
  
  "notifications": {
    "enableOwnerNotifications": true,
    "enablePurchaseNotifications": true,
    "enableStockAlerts": true,
    "lowStockThreshold": 10,
    "formats": {
      "purchase": "&a[Shop] &7{buyer} bought &e{amount}x {item} &7for &a${price}",
      "sale": "&a[Shop] &7{seller} sold &e{amount}x {item} &7for &a${price}",
      "lowStock": "&6[Shop] &7Your shop is low on &e{item} &7(&c{remaining} left&7)",
      "outOfStock": "&c[Shop] &7Your shop is out of &e{item}",
      "shopCreated": "&a[Shop] &7Shop created successfully at &e{location}",
      "shopRemoved": "&c[Shop] &7Shop removed at &e{location}"
    }
  },
  
  "adminShops": {
    "enabled": true,
    "infiniteStock": true,
    "infiniteSpace": true,
    "noOwner": true,
    "prefix": "&d[Admin Shop]",
    "defaultItems": [
      {
        "item": "minecraft:oak_log",
        "buyPrice": 1.0,
        "sellPrice": 0.5,
        "amount": 64
      },
      {
        "item": "minecraft:stone",
        "buyPrice": 0.5,
        "sellPrice": 0.25,
        "amount": 64
      },
      {
        "item": "minecraft:iron_ingot",
        "buyPrice": 10.0,
        "sellPrice": 8.0,
        "amount": 32
      },
      {
        "item": "minecraft:diamond",
        "buyPrice": 100.0,
        "sellPrice": 80.0,
        "amount": 16
      }
    ]
  },
  
  "playerShops": {
    "enabled": true,
    "requireChest": true,
    "autoRestock": false,
    "enablePrivateShops": true,
    "enablePublicShops": true,
    "maxShopsPerPlayer": {
      "default": 3,
      "vip": 5,
      "premium": 10,
      "staff": 20,
      "admin": -1
    },
    "shopExpiry": {
      "enabled": false,
      "inactiveDays": 30,
      "warningDays": 7
    }
  },
  
  "protection": {
    "enableShopProtection": true,
    "protectionRadius": 5,
    "allowBreaking": false,
    "allowPlacing": false,
    "allowInteraction": false,
    "protectChests": true,
    "protectSigns": true
  },
  
  "discord": {
    "enabled": true,
    "notifications": {
      "shopCreated": {
        "enabled": true,
        "channel": "general",
        "format": "🏪 **{player}** created a new shop at **{location}** selling **{item}** for **${price}**"
      },
      "majorPurchase": {
        "enabled": true,
        "channel": "general",
        "threshold": 1000.0,
        "format": "💰 **{buyer}** made a major purchase! Bought **{amount}x {item}** for **${total}** from **{owner}**'s shop"
      },
      "newRecord": {
        "enabled": true,
        "channel": "general",
        "format": "📈 New shop record! **{owner}**'s shop sold **{item}** for **${price}** - highest price this week!"
      }
    },
    "embeds": {
      "shopList": {
        "title": "🏪 Active Shops",
        "color": "#00ff00",
        "includeLocation": true,
        "includeStock": true,
        "includePrices": true
      }
    }
  },
  
  "database": {
    "saveInterval": 300,
    "enableBackup": true,
    "backupInterval": 3600,
    "maxBackups": 24,
    "compressionEnabled": true
  },
  
  "performance": {
    "enableCaching": true,
    "cacheTimeout": 60,
    "maxCacheSize": 500,
    "enableAsyncOperations": true,
    "maxBatchSize": 100
  },
  
  "debug": {
    "enabled": false,
    "logTransactions": true,
    "logShopCreation": true,
    "logErrors": true,
    "verboseLogging": false
  }
}
