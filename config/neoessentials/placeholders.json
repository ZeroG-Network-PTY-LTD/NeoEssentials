{
  "_comment": "Unified Placeholders Configuration for NeoEssentials",
  "_version": "2.0.0",
  "_description": "Comprehensive placeholder system with Discord integration and custom placeholders",
  
  "system": {
    "enabled": true,
    "cacheResults": true,
    "cacheTimeout": 30,
    "enableAnimations": true,
    "enableConditional": true,
    "enableCustom": true,
    "enableDiscord": true
  },
  
  "builtInPlaceholders": {
    "player": {
      "player_name": {
        "description": "Player's display name",
        "type": "string",
        "refreshRate": 0,
        "permission": null
      },
      "player_ping": {
        "description": "Player's connection ping",
        "type": "integer",
        "refreshRate": 20,
        "permission": null
      },
      "player_health": {
        "description": "Player's current health",
        "type": "float",
        "refreshRate": 10,
        "permission": null
      },
      "player_max_health": {
        "description": "Player's maximum health",
        "type": "float",
        "refreshRate": 0,
        "permission": null
      },
      "player_food": {
        "description": "Player's food level",
        "type": "integer",
        "refreshRate": 20,
        "permission": null
      },
      "player_level": {
        "description": "Player's experience level",
        "type": "integer",
        "refreshRate": 100,
        "permission": null
      },
      "player_x": {
        "description": "Player's X coordinate",
        "type": "integer",
        "refreshRate": 20,
        "permission": "neoessentials.placeholder.coords"
      },
      "player_y": {
        "description": "Player's Y coordinate",
        "type": "integer",
        "refreshRate": 20,
        "permission": "neoessentials.placeholder.coords"
      },
      "player_z": {
        "description": "Player's Z coordinate",
        "type": "integer",
        "refreshRate": 20,
        "permission": "neoessentials.placeholder.coords"
      },
      "player_world": {
        "description": "Player's current world",
        "type": "string",
        "refreshRate": 60,
        "permission": null
      }
    },
    "server": {
      "server_players": {
        "description": "Current online players",
        "type": "integer",
        "refreshRate": 20,
        "permission": null
      },
      "server_max_players": {
        "description": "Maximum player slots",
        "type": "integer",
        "refreshRate": 0,
        "permission": null
      },
      "server_tps": {
        "description": "Server TPS",
        "type": "float",
        "refreshRate": 20,
        "permission": "neoessentials.placeholder.server.tps"
      },
      "server_uptime": {
        "description": "Server uptime",
        "type": "string",
        "refreshRate": 1200,
        "permission": null
      },
      "server_memory_used": {
        "description": "Used memory in MB",
        "type": "integer",
        "refreshRate": 100,
        "permission": "neoessentials.placeholder.server.memory"
      },
      "server_memory_max": {
        "description": "Maximum memory in MB",
        "type": "integer",
        "refreshRate": 0,
        "permission": "neoessentials.placeholder.server.memory"
      },
      "server_memory_percent": {
        "description": "Memory usage percentage",
        "type": "float",
        "refreshRate": 100,
        "permission": "neoessentials.placeholder.server.memory"
      }
    },
    "economy": {
      "balance": {
        "description": "Player's current balance",
        "type": "float",
        "refreshRate": 60,
        "permission": null
      },
      "balance_formatted": {
        "description": "Player's balance with currency symbol",
        "type": "string",
        "refreshRate": 60,
        "permission": null
      },
      "balance_short": {
        "description": "Player's balance in short format (1.2K, 1.5M)",
        "type": "string",
        "refreshRate": 60,
        "permission": null
      }
    },
    "time": {
      "time": {
        "description": "Current server time (HH:mm)",
        "type": "string",
        "refreshRate": 1200,
        "permission": null
      },
      "time_seconds": {
        "description": "Current server time with seconds (HH:mm:ss)",
        "type": "string",
        "refreshRate": 20,
        "permission": null
      },
      "date": {
        "description": "Current date (YYYY-MM-DD)",
        "type": "string",
        "refreshRate": 1200,
        "permission": null
      },
      "datetime": {
        "description": "Current date and time",
        "type": "string",
        "refreshRate": 1200,
        "permission": null
      }
    }
  },
  
  "ftbIntegration": {
    "enabled": true,
    "placeholders": {
      "ftb_team_name": {
        "description": "Player's FTB team name",
        "type": "string",
        "refreshRate": 100,
        "permission": null
      },
      "ftb_team_display_name": {
        "description": "Player's FTB team display name with colors",
        "type": "string",
        "refreshRate": 100,
        "permission": null
      },
      "ftb_team_members": {
        "description": "Number of members in player's team",
        "type": "integer",
        "refreshRate": 200,
        "permission": null
      },
      "ftb_team_role": {
        "description": "Player's role in their FTB team",
        "type": "string",
        "refreshRate": 100,
        "permission": null
      },
      "ftb_has_team": {
        "description": "Whether player has a team (true/false)",
        "type": "boolean",
        "refreshRate": 100,
        "permission": null
      },
      "ftb_rank_name": {
        "description": "Player's FTB rank name",
        "type": "string",
        "refreshRate": 100,
        "permission": null
      },
      "ftb_rank_display_name": {
        "description": "Player's FTB rank display name with colors",
        "type": "string",
        "refreshRate": 100,
        "permission": null
      },
      "ftb_rank_weight": {
        "description": "Player's FTB rank weight/priority",
        "type": "integer",
        "refreshRate": 100,
        "permission": null
      },
      "ftb_has_rank": {
        "description": "Whether player has a rank (true/false)",
        "type": "boolean",
        "refreshRate": 100,
        "permission": null
      }
    }
  },
  
  "discordIntegration": {
    "enabled": true,
    "placeholders": {
      "discord_name": {
        "description": "Player's Discord username",
        "type": "string",
        "refreshRate": 0,
        "permission": null
      },
      "discord_linked": {
        "description": "Whether player is linked to Discord (true/false)",
        "type": "boolean",
        "refreshRate": 0,
        "permission": null
      },
      "discord_roles": {
        "description": "Player's Discord roles (comma separated)",
        "type": "string",
        "refreshRate": 300,
        "permission": null
      },
      "discord_status": {
        "description": "Discord integration status",
        "type": "string",
        "refreshRate": 60,
        "permission": "neoessentials.placeholder.discord.status"
      },
      "discord_linked_players": {
        "description": "Number of Discord linked players",
        "type": "integer",
        "refreshRate": 100,
        "permission": "neoessentials.placeholder.discord.stats"
      }
    }
  },
  
  "animatedPlaceholders": {
    "server_name_animated": {
      "type": "animation",
      "frames": [
        "&6&lNeoEssentials",
        "&e&lNeoEssentials",
        "&f&lNeoEssentials",
        "&e&lNeoEssentials"
      ],
      "duration": 1.0,
      "permission": null
    },
    "welcome_message": {
      "type": "animation",
      "frames": [
        "&6Welcome to the server!",
        "&e⭐ Welcome to the server! ⭐",
        "&6Welcome to the server!",
        "&e✨ Welcome to the server! ✨"
      ],
      "duration": 2.0,
      "permission": null
    },
    "server_status_indicator": {
      "type": "animation",
      "frames": [
        "&a●",
        "&a◐",
        "&a◑",
        "&a◒",
        "&a◓",
        "&a○"
      ],
      "duration": 0.5,
      "permission": null
    }
  },
  
  "conditionalPlaceholders": {
    "health_color": {
      "type": "conditional",
      "conditions": [
        {
          "condition": "{player_health} >= 18",
          "result": "&a{player_health}"
        },
        {
          "condition": "{player_health} >= 10",
          "result": "&e{player_health}"
        },
        {
          "condition": "{player_health} >= 5",
          "result": "&6{player_health}"
        },
        {
          "condition": "default",
          "result": "&c{player_health}"
        }
      ],
      "permission": null
    },
    "tps_color": {
      "type": "conditional",
      "conditions": [
        {
          "condition": "{server_tps} >= 19",
          "result": "&a{server_tps}"
        },
        {
          "condition": "{server_tps} >= 15",
          "result": "&e{server_tps}"
        },
        {
          "condition": "{server_tps} >= 10",
          "result": "&6{server_tps}"
        },
        {
          "condition": "default",
          "result": "&c{server_tps}"
        }
      ],
      "permission": "neoessentials.placeholder.server.tps"
    },
    "team_status": {
      "type": "conditional",
      "conditions": [
        {
          "condition": "{ftb_has_team} == true",
          "result": "Team: &b{ftb_team_display_name}"
        },
        {
          "condition": "default",
          "result": "&7No Team"
        }
      ],
      "permission": null
    },
    "rank_status": {
      "type": "conditional",
      "conditions": [
        {
          "condition": "{ftb_has_rank} == true",
          "result": "Rank: &a{ftb_rank_display_name}"
        },
        {
          "condition": "default",
          "result": "&7No Rank"
        }
      ],
      "permission": null
    }
  },
  
  "customPlaceholders": {
    "enabled": true,
    "loadFromFile": true,
    "customFile": "customPlaceholders.json",
    "examples": {
      "server_version": {
        "type": "static",
        "value": "NeoForge 1.21.1",
        "permission": null
      },
      "server_website": {
        "type": "static",
        "value": "www.neoessentials.net",
        "permission": null
      },
      "donation_link": {
        "type": "static",
        "value": "donate.neoessentials.net",
        "permission": null
      }
    }
  },
  
  "formatting": {
    "enableColorCodes": true,
    "enableRGBColors": true,
    "enableGradients": true,
    "enableHexColors": true,
    "colorCodePrefix": "&",
    "rgbFormat": "<#RRGGBB>",
    "gradientFormat": "<gradient:#COLOR1:#COLOR2>",
    "numberFormatting": {
      "thousandsSeparator": ",",
      "decimalPlaces": 2,
      "currencySymbol": "$",
      "currencyPosition": "before"
    }
  },
  
  "performance": {
    "enableCaching": true,
    "cacheSize": 1000,
    "defaultCacheTimeout": 30,
    "asyncProcessing": true,
    "maxProcessingTime": 50,
    "enableMetrics": false
  }
}
