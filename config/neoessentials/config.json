{
  "_comment": "Unified NeoEssentials Configuration",
  "_version": "2.0.0",
  "_description": "Main configuration file for NeoEssentials with Discord integration support",
  
  "general": {
    "serverName": "NeoEssentials Server",
    "defaultLanguage": "en",
    "debugMode": false,
    "enableColorCodes": true,
    "enableRGBColors": true,
    "savePlayerData": true,
    "autoSave": true,
    "autoSaveInterval": 300
  },
  
  "modules": {
    "economy": {
      "enabled": true,
      "startingBalance": 1000.0,
      "currencySymbol": "$",
      "balanceTop": true,
      "interestRate": 0.05
    },
    "homes": {
      "enabled": true,
      "maxHomes": {
        "default": 3,
        "vip": 5,
        "admin": 10
      },
      "cooldown": 60,
      "warmup": 3,
      "costs": {
        "setHome": 50.0,
        "teleportHome": 10.0,
        "deleteHome": 0.0
      },
      "safety": {
        "requireSafeLocation": true,
        "cancelOnMove": true,
        "cancelOnDamage": true,
        "maxMoveDistance": 0.5
      }
    },
    "warps": {
      "enabled": true,
      "cooldown": 30,
      "warmup": 5,
      "cost": 25.0,
      "requirePermission": true
    },
    "kits": {
      "enabled": true,
      "cooldown": 3600,
      "oneTimeUse": false,
      "requirePermission": true
    },
    "spawn": {
      "enabled": true,
      "teleportOnJoin": true,
      "teleportOnFirstJoin": true,
      "cooldown": 60,
      "warmup": 3
    },
    "teleportation": {
      "enabled": true,
      "tpa": {
        "enabled": true,
        "timeout": 60,
        "cooldown": 30,
        "warmup": 5
      },
      "rtp": {
        "enabled": true,
        "radius": 10000,
        "cooldown": 300,
        "maxAttempts": 10
      },
      "back": {
        "enabled": true,
        "cooldown": 60,
        "saveOnDeath": true,
        "saveOnTeleport": true
      }
    },
    "chat": {
      "enabled": true,
      "format": "{PREFIX}{DISPLAYNAME}&r: {MESSAGE}",
      "radius": 0,
      "localChat": false,
      "enableColors": true,
      "enableEmojis": true
    },
    "tablist": {
      "enabled": true,
      "useUnifiedConfig": true,
      "updateInterval": 20,
      "showHeader": true,
      "showFooter": true,
      "enableAnimations": true
    },
    "scoreboard": {
      "enabled": true,
      "useUnifiedConfig": true,
      "updateInterval": 20,
      "maxLines": 15,
      "enableAnimations": true
    },
    "moderation": {
      "enabled": true,
      "ban": true,
      "kick": true,
      "mute": true,
      "warn": true,
      "jail": false
    }
  },
  
  "commands": {
    "essential": {
      "heal": { "enabled": true, "permission": "neoessentials.command.heal", "cost": 0.0, "cooldown": 30 },
      "feed": { "enabled": true, "permission": "neoessentials.command.feed", "cost": 0.0, "cooldown": 30 },
      "fly": { "enabled": true, "permission": "neoessentials.command.fly", "cost": 0.0, "cooldown": 5 },
      "god": { "enabled": true, "permission": "neoessentials.command.god", "cost": 0.0, "cooldown": 5 },
      "vanish": { "enabled": true, "permission": "neoessentials.command.vanish", "cost": 0.0, "cooldown": 5 },
      "speed": { "enabled": true, "permission": "neoessentials.command.speed", "cost": 0.0, "cooldown": 10 },
      "gamemode": { "enabled": true, "permission": "neoessentials.command.gamemode", "cost": 0.0, "cooldown": 5 }
    },
    "teleportation": {
      "tp": { "enabled": true, "permission": "neoessentials.command.tp", "cost": 0.0, "cooldown": 5 },
      "tphere": { "enabled": true, "permission": "neoessentials.command.tphere", "cost": 0.0, "cooldown": 10 },
      "tpa": { "enabled": true, "permission": "neoessentials.command.tpa", "cost": 25.0, "cooldown": 30 },
      "home": { "enabled": true, "permission": "neoessentials.command.home", "cost": 10.0, "cooldown": 60 },
      "warp": { "enabled": true, "permission": "neoessentials.command.warp", "cost": 25.0, "cooldown": 30 },
      "spawn": { "enabled": true, "permission": "neoessentials.command.spawn", "cost": 0.0, "cooldown": 60 },
      "back": { "enabled": true, "permission": "neoessentials.command.back", "cost": 15.0, "cooldown": 60 }
    },
    "utility": {
      "give": { "enabled": true, "permission": "neoessentials.command.give", "cost": 0.0, "cooldown": 0 },
      "clear": { "enabled": true, "permission": "neoessentials.command.clear", "cost": 0.0, "cooldown": 5 },
      "repair": { "enabled": true, "permission": "neoessentials.command.repair", "cost": 100.0, "cooldown": 300 },
      "enchant": { "enabled": true, "permission": "neoessentials.command.enchant", "cost": 50.0, "cooldown": 60 },
      "skull": { "enabled": true, "permission": "neoessentials.command.skull", "cost": 25.0, "cooldown": 30 }
    },
    "social": {
      "msg": { "enabled": true, "permission": "neoessentials.command.msg", "cost": 0.0, "cooldown": 1 },
      "reply": { "enabled": true, "permission": "neoessentials.command.reply", "cost": 0.0, "cooldown": 1 },
      "broadcast": { "enabled": true, "permission": "neoessentials.command.broadcast", "cost": 0.0, "cooldown": 30 },
      "nick": { "enabled": true, "permission": "neoessentials.command.nick", "cost": 500.0, "cooldown": 3600 }
    }
  },
  
  "integrations": {
    "discord": {
      "enabled": true,
      "useEnhancedIntegration": true,
      "requireSimpleDiscordLink": true
    },
    "ftbTeams": {
      "enabled": true,
      "syncRanks": true,
      "syncTeams": true,
      "enableTeamPlaceholders": true
    },
    "ftbRanks": {
      "enabled": true,
      "syncPermissions": true,
      "enableRankPlaceholders": true
    },
    "worldEdit": {
      "enabled": true,
      "limitSelections": true,
      "maxSelectionSize": 1000000
    },
    "jei": {
      "enabled": true,
      "enableRecipeIntegration": true
    },
    "journeyMap": {
      "enabled": true,
      "enableWaypointSync": true
    },
    "luckPerms": {
      "disableNativePermissions": false,
      "syncGroups": true
    },
    "vault": {
      "disableNativeEconomy": false,
      "useVaultEconomy": true
    }
  },
  
  "performance": {
    "asyncOperations": true,
    "cachePlayerData": true,
    "cacheTimeout": 300,
    "maxCacheSize": 1000,
    "enableMetrics": true,
    "optimizeDatabase": true
  },
  
  "security": {
    "enableAntiCheat": false,
    "enableAntiGrief": true,
    "logCommands": true,
    "logTeleports": true,
    "logEconomyTransactions": true,
    "maxLoginAttempts": 3,
    "loginTimeout": 300
  },
  
  "protection": {
    "fireSpread": false,
    "creeperExplosion": false,
    "tntExplosion": false,
    "endermenPickup": false,
    "mobGriefing": false,
    "preventLavaFlow": false,
    "preventWaterFlow": false,
    "protectSpawn": true,
    "spawnRadius": 10
  },
  
  "newPlayerConfig": {
    "welcomeMessage": "&6Welcome &e{player_name}&6 to our server!",
    "giveStarterKit": true,
    "starterKit": "newcomer",
    "teleportToSpawn": true,
    "protectionTime": 300,
    "announceJoin": true,
    "enableTutorial": false
  },
  
  "messaging": {
    "motd": {
      "enabled": true,
      "message": "&6Welcome to &eNeoEssentials&6!\\n&7Type &a/help &7for commands"
    },
    "joinMessage": "&a{player_name} joined the server!",
    "leaveMessage": "&c{player_name} left the server!",
    "firstJoinMessage": "&6Welcome &e{player_name}&6 to the server for the first time!",
    "deathMessage": "&c{player_name} died: {death_message}",
    "enableCustomMessages": true,
    "enableBroadcasts": true,
    "broadcastInterval": 1800
  },
  
  "storage": {
    "type": "JSON",
    "backupEnabled": true,
    "backupInterval": 3600,
    "maxBackups": 24,
    "database": {
      "host": "localhost",
      "port": 3306,
      "name": "neoessentials",
      "username": "neoessentials",
      "password": "password",
      "useSSL": false
    }
  },
  
  "permissions": {
    "useBuiltInSystem": true,
    "defaultGroup": "default",
    "enableGroupInheritance": true,
    "enableWorldSpecificPermissions": false,
    "enableTimedPermissions": true
  }
}
