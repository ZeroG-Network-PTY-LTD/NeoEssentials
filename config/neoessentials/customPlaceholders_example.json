{
  "_comment": "NeoEssentials Custom Placeholders Configuration. Define your own placeholders for tablist, chat, GUIs, etc.",
  "_documentation": "Supported types: static, conditional, animated. Use ${placeholder_name} in your configs. See examples below.",
  "customPlaceholders": {
    "afk_tag": {
      "type": "conditional",
      "condition": "${essentials_afk} == true",
      "true": "&7[&cAFK&7]",
      "false": ""
    },
    "player_health_bar": {
      "type": "conditional",
      "condition": "${player_health} >= 15",
      "true": "&a❤❤❤❤❤",
      "false": "&c❤❤&8❤❤❤"
    },
    "server_status_animation": {
      "type": "animated",
      "frames": [
        "&a◉ &fOnline",
        "&e◉ &fOnline",
        "&6◉ &fOnline",
        "&c◉ &fOnline"
      ],
      "interval": 0.8
    },
    "loading_indicator": {
      "type": "animated",
      "frames": [
        "&7Loading.",
        "&7Loading..",
        "&7Loading...",
        "&7Loading"
      ],
      "interval": 0.4
    },
    "welcome_message": {
      "type": "static",
      "value": "&6Welcome to &bNeoEssentials &6Server!"
    },
    "ping_colored": {
      "type": "conditional",
      "condition": "${player_ping} < 100",
      "true": "&a${player_ping}ms",
      "false": "&c${player_ping}ms"
    },
    "rank_prefix": {
      "type": "static",
      "value": "${prefix}"
    }
  }
}
