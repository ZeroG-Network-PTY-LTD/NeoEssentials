{
  "customPlaceholders": {
    "afk_tag": {
      "type": "conditional",
      "condition": "${essentials_afk} == true",
      "trueValue": "&7[&cAFK&7]",
      "falseValue": "",
      "interval": 0.0
    },
    "welcome_message": {
      "type": "static",
      "value": "&6Welcome to &bNeoEssentials &6Server!",
      "interval": 0.0
    },
    "server_status_animation": {
      "type": "animated",
      "frames": [
        "&a● &fOnline",
        "&e● &fOnline", 
        "&6● &fOnline",
        "&c● &fOnline"
      ],
      "interval": 1.0
    },
    "tps_indicator": {
      "type": "conditional",
      "condition": "${server_tps} >= 18.0",
      "trueValue": "&a⚡ &f${server_tps} TPS",
      "falseValue": "&c⚡ &f${server_tps} TPS",
      "interval": 0.0
    },
    "performance_bar": {
      "type": "animated",
      "frames": [
        "&a▓▓▓▓▓▓▓▓▓▓ &f100%",
        "&a▓▓▓▓▓▓▓▓▓&7▒ &f90%",
        "&e▓▓▓▓▓▓▓▓&7▒▒ &f80%",
        "&6▓▓▓▓▓▓▓&7▒▒▒ &f70%",
        "&c▓▓▓▓▓▓&7▒▒▒▒ &f60%",
        "&c▓▓▓▓▓&7▒▒▒▒▒ &f50%"
      ],
      "interval": 2.0
    },
    "test_animation": {
      "type": "animated",
      "frames": [
        "&a[1]",
        "&b[2]",
        "&c[3]",
        "&d[4]",
        "&e[5]"
      ],
      "interval": 0.5
    },
    "ping_colored": {
      "type": "conditional",
      "condition": "${player_ping} < 100",
      "trueValue": "&a",
      "falseValue": "&c",
      "interval": 0.0
    },
    "server_status": {
      "type": "conditional",
      "condition": "${server_tps} >= 18.0",
      "trueValue": "&a&l●&r &aOnline",
      "falseValue": "&c&l●&r &cLag Detected",
      "interval": 0.0
    },
    "player_health_status": {
      "type": "conditional",
      "condition": "${player_health} > 15",
      "trueValue": "&a❤ &aHealthy",
      "falseValue": "&c❤ &cCritical",
      "interval": 0.0
    },
    "discord_status": {
      "type": "conditional",
      "condition": "${discord_linked}",
      "trueValue": "&9Discord: &a✓",
      "falseValue": "&9Discord: &c✗",
      "interval": 0.0
    },
    "welcome_animation": {
      "type": "animated",
      "frames": [
        "&cWelcome &f${player_name}",
        "&eWelcome &f${player_name}",
        "&aWelcome &f${player_name}",
        "&bWelcome &f${player_name}",
        "&dWelcome &f${player_name}"
      ],
      "interval": 0.3
    },
    "ping_indicator": {
      "type": "conditional",
      "condition": "${player_ping} < 50",
      "trueValue": "&a${player_ping}ms ●●●",
      "falseValue": "&c${player_ping}ms ●○○",
      "interval": 0.0
    },
    "server_info": {
      "type": "static",
      "value": "&6NeoEssentials &7- &bPremium Minecraft Experience",
      "interval": 0.0
    },
    "afk_status": {
      "type": "conditional",
      "condition": "${essentials_afk}",
      "trueValue": "&7[AFK]",
      "falseValue": "",
      "interval": 0.0
    },
    "world_display": {
      "type": "conditional",
      "condition": "${player_world} == 'overworld'",
      "trueValue": "&a🌍 Overworld",
      "falseValue": "&7🌐 ${player_world}",
      "interval": 0.0
    },
    "weather_status": {
      "type": "conditional",
      "condition": "${world_weather} == 'clear'",
      "trueValue": "&a☀ Clear",
      "falseValue": "&b🌧 Rain",
      "interval": 0.0
    },
    "permission_level": {
      "type": "conditional",
      "condition": "${player_op}",
      "trueValue": "&c&lOP",
      "falseValue": "&a&lPLAYER",
      "interval": 0.0
    },
    "location_coords": {
      "type": "static",
      "value": "&7X: &e${player_x} &7Y: &e${player_y} &7Z: &e${player_z}",
      "interval": 0.0
    }
  }
}
