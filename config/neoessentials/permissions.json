    "verified": {
      "displayName": "&7[VERIFIED]&r",
      "priority": 100,
      "inheritance": ["default"],
      "permissions": [
        "neoessentials.verified.*",
        "neoessentials.command.home",
        "neoessentials.command.sethome",
        "neoessentials.command.spawn",
        "neoessentials.command.tpa",
        "neoessentials.command.kit.starter",
        "neoessentials.feature.homes.verified"
