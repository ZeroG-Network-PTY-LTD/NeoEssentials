      "suffix": "",
      "chatColor": "&8",
      "tablistFormat": "&8{player_name}&r",
      "scoreboardTitle": "&8&lGUEST",
      "discordRoles": [],
      "economy": {
        "startingBalance": 100.0,
        "allowNegative": false,
        "maxBalance": 5000
      }
    }
  },
  
  "specialPermissions": {
    "commandOverrides": {
      "neoessentials.command.fly": {
        "description": "Allows player to toggle fly mode",
        "defaultValue": false,
        "worldSpecific": false
      },
      "neoessentials.command.god": {
        "description": "Allows player to toggle invincibility",
        "defaultValue": false,
        "worldSpecific": false
      },
      "neoessentials.bypass.cooldown": {
        "description": "Bypasses command cooldowns",
        "defaultValue": false,
        "worldSpecific": false
      },
      "neoessentials.bypass.cost": {
        "description": "Bypasses command costs",
        "defaultValue": false,
        "worldSpecific": false
      }
    },
    "featurePermissions": {
      "neoessentials.feature.chat.colors": {
        "description": "Allows use of color codes in chat",
        "defaultValue": false,
        "worldSpecific": false
      },
      "neoessentials.feature.chat.rgb": {
        "description": "Allows use of RGB colors in chat",
        "defaultValue": false,
        "worldSpecific": false
      },
      "neoessentials.feature.unlimited.homes": {
        "description": "Allows unlimited homes",
        "defaultValue": false,
        "worldSpecific": false
      }
    }
  },
  
  "discordIntegration": {
    "enabled": true,
    "syncRoles": true,
    "syncOnJoin": true,
    "syncInterval": 300,
    "bidirectional": true,
    "roleMapping": {
      "123456789012345678": {
        "roleName": "Owner",
        "minecraftGroup": "owner",
        "priority": 1000,
        "autoAssign": true,
        "permissions": ["neoessentials.*"]
      },
      "123456789012345679": {
        "roleName": "Admin",
        "minecraftGroup": "admin",
        "priority": 800,
        "autoAssign": true,
        "permissions": ["neoessentials.admin.*"]
      },
      "123456789012345680": {
        "roleName": "Moderator",
        "minecraftGroup": "moderator",
        "priority": 600,
        "autoAssign": true,
        "permissions": ["neoessentials.moderator.*"]
      },
      "123456789012345681": {
        "roleName": "Helper",
        "minecraftGroup": "helper",
        "priority": 400,
        "autoAssign": true,
        "permissions": ["neoessentials.helper.*"]
      },
      "123456789012345682": {
        "roleName": "VIP",
        "minecraftGroup": "vip",
        "priority": 300,
        "autoAssign": true,
        "permissions": ["neoessentials.vip.*"]
      },
      "123456789012345683": {
        "roleName": "Premium",
        "minecraftGroup": "premium",
        "priority": 200,
        "autoAssign": true,
        "permissions": ["neoessentials.premium.*"]
      },
      "123456789012345684": {
        "roleName": "Member",
        "minecraftGroup": "member",
        "priority": 150,
        "autoAssign": true,
        "permissions": ["neoessentials.member.*"]
      },
      "123456789012345685": {
        "roleName": "Verified",
        "minecraftGroup": "verified",
        "priority": 100,
        "autoAssign": true,
        "permissions": ["neoessentials.verified.*"]
      }
    },
    "fallbackGroup": "default",
    "requireLinking": false,
    "notifications": {
      "roleSync": true,
      "permissionChanges": true,
      "groupChanges": true
    }
  },
  
  "antiSpam": {
    "enabled": true,
    "commandSpamThreshold": 5,
    "commandSpamWindow": 10,
    "chatSpamThreshold": 3,
    "chatSpamWindow": 5,
    "punishmentType": "mute",
    "punishmentDuration": 300
  }
}
