{
  "_comment": "Unified Permissions Configuration for NeoEssentials",
  "_version": "2.0.0",
  "_description": "Comprehensive permission system with Discord integration and role mapping",
  
  "system": {
    "enabled": true,
    "defaultGroup": "default",
    "enableInheritance": true,
    "enableWorldPermissions": false,
    "enableTimedPermissions": true,
    "cachePermissions": true,
    "cacheTimeout": 300
  },
  
  "groups": {
    "owner": {
      "displayName": "&4[OWNER]&r",
      "priority": 1000,
      "inheritance": [],
      "permissions": [
        "neoessentials.*",
        "*"
      ],
      "prefix": "&4[OWNER]&r ",
      "suffix": " &4⭐&r",
      "chatColor": "&4",
      "tablistFormat": "&4{player_name}&r",
      "scoreboardTitle": "&4&lOWNER",
      "discordRoles": ["Owner", "Administrator"],
      "economy": {
        "startingBalance": 10000.0,
        "allowNegative": true,
        "maxBalance": -1
      }
    },
    "admin": {
      "displayName": "&c[ADMIN]&r",
      "priority": 800,
      "inheritance": ["moderator"],
      "permissions": [
        "neoessentials.admin.*",
        "neoessentials.command.*",
        "neoessentials.bypass.*",
        "neoessentials.feature.*"
      ],
      "prefix": "&c[ADMIN]&r ",
      "suffix": " &c⚡&r",
      "chatColor": "&c",
      "tablistFormat": "&c{player_name}&r",
      "scoreboardTitle": "&c&lADMIN",
      "discordRoles": ["Admin", "Staff"],
      "economy": {
        "startingBalance": 5000.0,
        "allowNegative": true,
        "maxBalance": -1
      }
    },
    "moderator": {
      "displayName": "&6[MOD]&r",
      "priority": 600,
      "inheritance": ["helper"],
      "permissions": [
        "neoessentials.moderator.*",
        "neoessentials.command.ban",
        "neoessentials.command.kick",
        "neoessentials.command.mute",
        "neoessentials.command.warn",
        "neoessentials.command.tp",
        "neoessentials.command.tphere",
        "neoessentials.command.vanish",
        "neoessentials.command.god",
        "neoessentials.command.fly",
        "neoessentials.command.speed",
        "neoessentials.command.heal",
        "neoessentials.command.feed",
        "neoessentials.bypass.cooldown",
        "neoessentials.bypass.cost"
      ],
      "prefix": "&6[MOD]&r ",
      "suffix": " &6🛡️&r",
      "chatColor": "&6",
      "tablistFormat": "&6{player_name}&r",
      "scoreboardTitle": "&6&lMODERATOR",
      "discordRoles": ["Moderator", "Staff"],
      "economy": {
        "startingBalance": 2500.0,
        "allowNegative": false,
        "maxBalance": 1000000
      }
    },
    "helper": {
      "displayName": "&b[HELPER]&r",
      "priority": 400,
      "inheritance": ["vip"],
      "permissions": [
        "neoessentials.helper.*",
        "neoessentials.command.tp",
        "neoessentials.command.tphere",
        "neoessentials.command.heal",
        "neoessentials.command.feed",
        "neoessentials.command.fly",
        "neoessentials.command.vanish",
        "neoessentials.feature.chat.colors",
        "neoessentials.feature.unlimited.homes"
