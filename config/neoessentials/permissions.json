    },
    "vip": {
      "displayName": "&d[VIP]&r",
      "priority": 300,
      "inheritance": ["premium"],
      "permissions": [
        "neoessentials.vip.*",
        "neoessentials.command.fly",
        "neoessentials.command.heal",
        "neoessentials.command.feed",
        "neoessentials.command.kit.vip",
        "neoessentials.command.nick",
        "neoessentials.feature.chat.colors",
        "neoessentials.feature.homes.vip",
        "neoessentials.bypass.cooldown.minor"
      ],
      "prefix": "&d[VIP]&r ",
      "suffix": " &d💎&r",
      "chatColor": "&d",
      "tablistFormat": "&d{player_name}&r",
      "scoreboardTitle": "&d&lVIP",
      "discordRoles": ["VIP", "Donator"],
      "economy": {
        "startingBalance": 1500.0,
        "allowNegative": false,
        "maxBalance": 250000
