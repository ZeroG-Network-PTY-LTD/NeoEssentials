          "&f● &7Ping: &e{player_ping}ms",
          "",
          "&f● &7Create a team with &a/team create",
          "&7&m─────────────────"
        ]
      }
    ]
  },

  "bossbar": {
    "enabled": true,
    "updateInterval": 20,
    "layouts": [
      {
        "priority": 300,
        "conditionType": "permission",
        "condition": "neoessentials.bossbar.admin",
        "bars": [
          {
            "id": "admin_main",
            "text": "&c&lADMIN &7| &f{player_name} &7| &aTPS: {server_tps} &7| &eMemory: {server_memory_percent}%",
            "color": "RED",
            "style": "PROGRESS",
            "progress": 1.0
          }
        ]
      },
      {
        "priority": 250,
        "conditionType": "permission",
        "condition": "neoessentials.bossbar.staff",
        "bars": [
          {
            "id": "staff_main",
            "text": "&6&lSTAFF &7| &f{player_name} &7| &bTeam: {ftb_team_display_name} &7| &aRank: {ftb_rank_display_name}",
            "color": "YELLOW",
            "style": "PROGRESS",
            "progress": 1.0
          }
        ]
      },
      {
        "priority": 200,
        "conditionType": "placeholder",
        "condition": "ftb_team_role:Owner",
        "bars": [
          {
            "id": "team_owner",
            "text": "&e&lTEAM OWNER &7| &f{player_name} &7| &bTeam: {ftb_team_display_name} &7| &eMembers: {ftb_team_members}",
            "color": "YELLOW",
            "style": "SEGMENTED_10",
            "progress": 1.0
          }
        ]
      },
      {
        "priority": 150,
        "conditionType": "placeholder",
        "condition": "ftb_team_role:Moderator",
        "bars": [
          {
            "id": "team_mod",
            "text": "&9&lTEAM MOD &7| &f{player_name} &7| &bTeam: {ftb_team_display_name} &7| &eMembers: {ftb_team_members}",
            "color": "BLUE",
            "style": "SEGMENTED_10",
            "progress": 0.8
          }
        ]
      },
      {
        "priority": 100,
        "conditionType": "placeholder",
        "condition": "ftb_has_team:true",
        "bars": [
          {
            "id": "team_member",
            "text": "&a&lTEAM MEMBER &7| &f{player_name} &7| &bTeam: {ftb_team_display_name} &7| &aRole: {ftb_team_role}",
            "color": "GREEN",
            "style": "SEGMENTED_6",
            "progress": 0.6
          }
        ]
      },
      {
        "priority": 50,
        "conditionType": "placeholder",
        "condition": "ftb_has_rank:true",
        "bars": [
          {
            "id": "ranked_player",
            "text": "&f&lRANKED &7| &f{player_name} &7| &aRank: {ftb_rank_display_name} &7| &eWeight: {ftb_rank_weight}",
            "color": "WHITE",
            "style": "PROGRESS",
            "progress": 0.4
          }
        ]
      },
      {
        "priority": 1,
        "conditionType": "default",
        "bars": [
          {
            "id": "default_player",
            "text": "&7Welcome &f{player_name} &7| &eOnline: {server_players}/{server_max_players} &7| &fTime: {time}",
            "color": "WHITE",
            "style": "PROGRESS",
            "progress": 0.2
          }
        ]
      }
    ]
  },

  "animations": {
    "enabled": true,
    "updateInterval": 5,
    "sequences": [
      {
        "id": "server_status",
        "frames": [
          "&a●",
          "&e●",
          "&6●",
          "&c●"
        ],
        "duration": 0.5
      },
      {
        "id": "loading_dots",
        "frames": [
          "&7.",
          "&7..",
          "&7...",
          "&7"
        ],
        "duration": 0.3
      },
      {
        "id": "rainbow_star",
        "frames": [
          "&c★",
          "&6★",
          "&e★",
          "&a★",
          "&b★",
          "&9★",
          "&5★"
        ],
        "duration": 0.2
      }
    ]
  },

  "conditional_placeholders": {
    "online_count": "{server_players}",
    "max_players": "{server_max_players}",
    "team_status": {
      "has_team": "&aIn Team",
      "no_team": "&7No Team"
    },
    "rank_status": {
      "has_rank": "&aRanked",
      "no_rank": "&7Unranked"
    }
  },
  "discordIntegration": {
    "enabled": true,
    "messageFormatting": {
      "useEmbeds": true,
      "timestampFormat": "yyyy-MM-dd HH:mm:ss",
      "includePlayerStats": true,
      "includeTeamInfo": true,
      "includeRankInfo": true
    },
    "notifications": {
      "tablistUpdates": {
        "enabled": true,
        "channel": "general",
        "format": "🔄 **{player_name}** | Tablist updated | Team: **{ftb_team_display_name}** | Rank: **{ftb_rank_display_name}**"
      },
      "scoreboardUpdates": {
        "enabled": true,
        "channel": "general",
        "format": "📊 **{player_name}** | Scoreboard updated | Layout: **{layout_name}**"
      },
      "playerJoin": {
        "enabled": true,
        "channel": "general",
        "format": "✅ **{player_name}** joined! | Team: **{ftb_team_display_name}** | Rank: **{ftb_rank_display_name}** | Health: **{player_health}/{player_max_health}** ❤️"
      },
      "playerLeave": {
        "enabled": true,
        "channel": "general",
        "format": "❌ **{player_name}** left | Session: **{session_time}** | Team: **{ftb_team_display_name}**"
      },
      "teamUpdates": {
        "enabled": true,
        "channel": "general",
        "format": "👥 **{player_name}** | Team updated | Old: **{old_team}** → New: **{ftb_team_display_name}**"
      },
      "rankUpdates": {
        "enabled": true,
        "channel": "general",
        "format": "🎖️ **{player_name}** | Rank updated | Old: **{old_rank}** → New: **{ftb_rank_display_name}**"
      },
      "permissionChanges": {
        "enabled": true,
        "channel": "admin",
        "format": "🔐 **{player_name}** | Permission **{permission}** | Action: **{action}** | By: **{admin}**"
      },
      "achievements": {
        "enabled": true,
        "channel": "general",
        "format": "🏆 **{player_name}** earned **{achievement}**! | Team: **{ftb_team_display_name}**"
      }
    },
    "roleSync": {
      "enabled": true,
      "syncOnJoin": true,
      "syncInterval": 300,
      "bidirectional": true,
      "roleMappings": {
        "Owner": {
          "minecraftPermission": "neoessentials.admin",
          "priority": 1000,
          "tablistPrefix": "&4[OWNER]&r",
          "scoreboardTitle": "&4&lOWNER"
        },
        "Admin": {
          "minecraftPermission": "neoessentials.moderator",
          "priority": 800,
          "tablistPrefix": "&c[ADMIN]&r",
          "scoreboardTitle": "&c&lADMIN"
        },
        "Moderator": {
          "minecraftPermission": "neoessentials.helper",
          "priority": 600,
          "tablistPrefix": "&6[MOD]&r",
          "scoreboardTitle": "&6&lMODERATOR"
        },
        "VIP": {
          "minecraftPermission": "neoessentials.vip",
          "priority": 400,
          "tablistPrefix": "&d[VIP]&r",
          "scoreboardTitle": "&d&lVIP"
        },
        "Member": {
          "minecraftPermission": "neoessentials.member",
          "priority": 200,
          "tablistPrefix": "&a[MEMBER]&r",
          "scoreboardTitle": "&a&lMEMBER"
        },
        "Verified": {
          "minecraftPermission": "neoessentials.verified",
          "priority": 100,
          "tablistPrefix": "&7[VERIFIED]&r",
          "scoreboardTitle": "&7&lVERIFIED"
        }
      },
      "fallbackRole": {
        "minecraftPermission": "neoessentials.default",
        "priority": 0,
        "tablistPrefix": "&8[GUEST]&r",
        "scoreboardTitle": "&8&lGUEST"
      }
    },
    "chatSync": {
      "enabled": true,
      "includeTeamInfo": true,
      "includeRankInfo": true,
      "format": "**[{ftb_rank_display_name}]** {player_name}: {message}",
      "filterProfanity": true,
      "maxMessageLength": 2000
    },
    "statusUpdates": {
      "enabled": true,
      "updateInterval": 60,
      "channel": "status",
      "embedStyle": {
        "color": "#00ff00",
        "title": "🎮 NeoEssentials Server Status",
        "fields": [
          {
            "name": "👥 Players Online",
            "value": "{players_online}/{max_players}",
            "inline": true
          },
          {
            "name": "🏆 Top Team",
            "value": "{top_team_name} ({top_team_members} members)",
            "inline": true
          },
          {
            "name": "⚡ Server Health",
            "value": "TPS: {server_tps} | RAM: {used_memory}/{max_memory}MB",
            "inline": false
          },
          {
            "name": "📊 Active Layouts",
            "value": "Tablist: {active_tablist_layouts} | Scoreboard: {active_scoreboard_layouts}",
            "inline": false
          }
        ],
        "footer": "Last updated: {timestamp}",
        "thumbnail": "https://i.imgur.com/server-icon.png"
      }
    },
    "webhooks": {
      "enabled": true,
      "useWebhookForChat": true,
      "useWebhookForNotifications": true,
      "avatarPlaceholder": "https://minotar.net/helm/{player_name}/64.png",
      "defaultAvatar": "https://i.imgur.com/default-avatar.png"
    },
