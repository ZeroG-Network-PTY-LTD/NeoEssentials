{
  "_comment": "Dedicated Tablist Configuration for NeoEssentials",
  "_description": "Advanced tablist system with permission-based layouts and FTB Teams integration",
  "_ftbIntegration": "This configuration automatically integrates with FTB Teams/Ranks if the mods are installed",
  
  "tablist": {
    "enabled": true,
    "updateInterval": 20,
    "format": "{ftb_combined_prefix}[{team_name}] {player_name}{ftb_combined_suffix}",
    
    "layouts": [
      {
        "priority": 300,
        "conditionType": "permission",
        "condition": "neoessentials.tablist.admin",
        "header": [
          "&c&l╔═══════════════════════════════════╗",
          "&c&l║           &f&lADMIN PANEL          &c&l║",
          "&c&l╠═══════════════════════════════════╣",
          "&c&l║ &f&lWelcome &e{player_name}           &c&l║",
          "&c&l║ &7Team: &b{ftb_team_display_name}                &c&l║",
          "&c&l║ &7Rank: &a{ftb_rank_display_name}                &c&l║",
          "&c&l║ &7Role: &6{ftb_team_role}                 &c&l║",
          "&c&l╚═══════════════════════════════════╝"
        ],
        "footer": [
          "&c&l╔═══════════════════════════════════╗",
          "&c&l║ &7Server: &a{server_name}           &c&l║",
          "&c&l║ &7Online: &e{server_players}&7/&e{server_max_players}              &c&l║",
          "&c&l║ &7TPS: &a{server_tps}                   &c&l║",
          "&c&l║ &7Memory: &e{server_memory_percent}%            &c&l║",
          "&c&l║ &7Status: ${server_status_animation}     &c&l║",
          "&c&l║ &7Welcome: ${welcome_animation}          &c&l║",
          "&c&l║ &7Time: &f{time}                   &c&l║",
          "&c&l╚═══════════════════════════════════╝"
        ]
      },
      {
        "priority": 250,
        "conditionType": "permission",
        "condition": "neoessentials.tablist.staff",
        "header": [
          "&6&l╔═══════════════════════════════════╗",
          "&6&l║          &f&lSTAFF MEMBER         &6&l║",
          "&6&l╠═══════════════════════════════════╣",
          "&6&l║ &f&lWelcome &e{player_name}           &6&l║",
          "&6&l║ &7Team: &b{ftb_team_display_name}                &6&l║",
          "&6&l║ &7Rank: &a{ftb_rank_display_name}                &6&l║",
          "&6&l║ &7Role: &9{ftb_team_role}                 &6&l║",
          "&6&l╚═══════════════════════════════════╝"
        ],
        "footer": [
          "&6&l╔═══════════════════════════════════╗",
          "&6&l║ &7Players: &e{server_players}&7/&e{server_max_players}            &6&l║",
          "&6&l║ &7Your Ping: &a{player_ping}ms             &6&l║",
          "&6&l║ &7Team Members: &e{ftb_team_members}           &6&l║",
          "&6&l║ &7Date: &f{date}                  &6&l║",
          "&6&l╚═══════════════════════════════════╝"
        ]
      },
      {
        "priority": 200,
        "conditionType": "placeholder",
        "condition": "ftb_team_role:Owner",
        "header": [
          "&e&l╔═══════════════════════════════════╗",
          "&e&l║         &f&lTEAM OWNER           &e&l║",
          "&e&l╠═══════════════════════════════════╣",
          "&e&l║ &f&lWelcome &6{player_name}           &e&l║",
          "&e&l║ &7Team: &b{ftb_team_display_name}                &e&l║",
          "&e&l║ &7Rank: &a{ftb_rank_display_name}                &e&l║",
          "&e&l║ &7Members: &e{ftb_team_members}               &e&l║",
          "&e&l╚═══════════════════════════════════╝"
        ],
        "footer": [
          "&e&l╔═══════════════════════════════════╗",
          "&e&l║ &7Your Role: &c&lOWNER             &e&l║",
          "&e&l║ &7Rank Weight: &e{ftb_rank_weight}            &e&l║",
          "&e&l║ &7Online: &a{server_players}&7/&a{server_max_players}              &e&l║",
          "&e&l║ &7Time: &f{time}                   &e&l║",
          "&e&l╚═══════════════════════════════════╝"
        ]
      },
      {
        "priority": 150,
        "conditionType": "placeholder",
        "condition": "ftb_team_role:Moderator",
        "header": [
          "&9&l╔═══════════════════════════════════╗",
          "&9&l║       &f&lTEAM MODERATOR        &9&l║",
          "&9&l╠═══════════════════════════════════╣",
          "&9&l║ &f&lWelcome &b{player_name}           &9&l║",
          "&9&l║ &7Team: &b{ftb_team_display_name}                &9&l║",
          "&9&l║ &7Rank: &a{ftb_rank_display_name}                &9&l║",
          "&9&l║ &7Members: &e{ftb_team_members}               &9&l║",
          "&9&l╚═══════════════════════════════════╝"
        ],
        "footer": [
          "&9&l╔═══════════════════════════════════╗",
          "&9&l║ &7Your Role: &9&lMODERATOR         &9&l║",
          "&9&l║ &7Rank Weight: &e{ftb_rank_weight}            &9&l║",
          "&9&l║ &7Online: &a{server_players}&7/&a{server_max_players}              &9&l║",
          "&9&l║ &7Time: &f{time}                   &9&l║",
          "&9&l╚═══════════════════════════════════╝"
        ]
      },
      {
        "priority": 100,
        "conditionType": "placeholder",
        "condition": "ftb_has_team:true",
        "header": [
          "&a&l╔═══════════════════════════════════╗",
          "&a&l║        &f&lTEAM MEMBER          &a&l║",
          "&a&l╠═══════════════════════════════════╣",
          "&a&l║ &f&lWelcome &2{player_name}           &a&l║",
          "&a&l║ &7Team: &b{ftb_team_display_name}                &a&l║",
          "&a&l║ &7Rank: &e{ftb_rank_display_name}                &a&l║",
          "&a&l║ &7Members: &e{ftb_team_members}               &a&l║",
          "&a&l╚═══════════════════════════════════╝"
        ],
        "footer": [
          "&a&l╔═══════════════════════════════════╗",
          "&a&l║ &7Your Role: &a&lMEMBER            &a&l║",
          "&a&l║ &7Team Color: {ftb_team_color}●               &a&l║",
          "&a&l║ &7Online: &e{server_players}&7/&e{server_max_players}              &a&l║",
          "&a&l║ &7Time: &f{time}                   &a&l║",
          "&a&l╚═══════════════════════════════════╝"
        ]
      },
      {
        "priority": 50,
        "conditionType": "placeholder",
        "condition": "ftb_has_rank:true",
        "header": [
          "&f&l╔═══════════════════════════════════╗",
          "&f&l║       &7&lRANKED PLAYER         &f&l║",
          "&f&l╠═══════════════════════════════════╣",
          "&f&l║ &7Welcome &f{player_name}             &f&l║",
          "&f&l║ &7Rank: &a{ftb_rank_display_name}                &f&l║",
          "&f&l║ &7Weight: &e{ftb_rank_weight}                &f&l║",
          "&f&l║ &7Permissions: &e{ftb_rank_permissions}         &f&l║",
          "&f&l╚═══════════════════════════════════╝"
        ],
        "footer": [
          "&f&l╔═══════════════════════════════════╗",
          "&f&l║ &7Your Rank: &a{ftb_rank_display_name}           &f&l║",
          "&f&l║ &7Join a team to unlock more!     &f&l║",
          "&f&l║ &7Online: &e{server_players}&7/&e{server_max_players}              &f&l║",
          "&f&l║ &7Time: &f{time}                   &f&l║",
          "&f&l╚═══════════════════════════════════╝"
        ]
      },
      {
        "priority": 1,
        "conditionType": "default",
        "header": [
          "&7&l╔═══════════════════════════════════╗",
          "&7&l║       &8&lDEFAULT PLAYER        &7&l║",
          "&7&l╠═══════════════════════════════════╣",
          "&7&l║ &8Welcome &7{player_name}             &7&l║",
          "&7&l║ &8No team or rank assigned        &7&l║",
          "&7&l║ &8Join a team to get started!     &7&l║",
          "&7&l╚═══════════════════════════════════╝"
        ],
        "footer": [
          "&7&l╔═══════════════════════════════════╗",
          "&7&l║ &8Use /team create <name>         &7&l║",
          "&7&l║ &8to create your own team!        &7&l║",
          "&7&l║ &8Online: &7{server_players}&8/&7{server_max_players}              &7&l║",
          "&7&l║ &8Status: ${server_status_animation}      &7&l║",
          "&7&l║ &8Test: ${test_animation}                &7&l║",
          "&7&l║ &8Time: &7{time}                   &7&l║",
          "&7&l╚═══════════════════════════════════╝"
        ]
      }
    ],
    
    "playerOrder": [
      { "placeholder": "ftb_rank_weight", "direction": "desc", "asNumber": true },
      { "placeholder": "ftb_team_role", "direction": "desc" },
      { "placeholder": "player_name", "direction": "asc" },
      { "placeholder": "ping", "direction": "asc", "asNumber": true }
    ],
    
    "ftbIntegration": {
      "_comment": "FTB Teams and Ranks integration - only works if mods are installed",
      "enableTeamIntegration": true,
      "enableRankIntegration": true,
      "fallbackIfNotInstalled": true,
      "teamPlaceholders": {
        "ftb_team_display_name": "Team",
        "ftb_team_members": "0",
        "ftb_team_role": "Member",
        "ftb_team_color": "&7",
        "ftb_has_team": "false"
      },
      "rankPlaceholders": {
        "ftb_rank_display_name": "No Rank",
        "ftb_rank_weight": "0",
        "ftb_rank_permissions": "0",
        "ftb_has_rank": "false"
      }
    }
  }
}
