    "playerOrder": [
      { "placeholder": "ftb_rank_weight", "direction": "desc", "asNumber": true },
      { "placeholder": "ftb_team_role", "direction": "desc" },
      { "placeholder": "player_name", "direction": "asc" },
      { "placeholder": "ping", "direction": "asc", "asNumber": true }
    ]
  },

  "scoreboard": {
    "enabled": true,
    "updateInterval": 20,
    "title": "&6&lNeoEssentials",
    "layouts": [
      {
        "priority": 200,
        "conditionType": "permission",
        "condition": "neoessentials.scoreboard.admin",
        "lines": [
          "&7&m─────────────────",
          "&c&lADMIN PANEL",
          "&7&m─────────────────",
          "&f● &7Player: &e{player_name}",
          "&f● &7Rank: &a{ftb_rank_display_name}",
          "&f● &7Team: &b{ftb_team_display_name}",
          "&f● &7Role: &6{ftb_team_role}",
          "",
          "&f● &7TPS: &a{server_tps}",
          "&f● &7Memory: &e{server_memory_percent}%",
          "&f● &7Players: &e{server_players}&7/&e{server_max_players}",
          "",
          "&f● &7Location:",
          "&f  &7X: &e{player_x}",
          "&f  &7Y: &e{player_y}",
          "&f  &7Z: &e{player_z}",
          "&f  &7World: &e{player_world}",
          "&7&m─────────────────"
        ]
      },
      {
        "priority": 150,
        "conditionType": "placeholder",
        "condition": "ftb_has_team:true",
        "lines": [
          "&7&m─────────────────",
          "&b&lTEAM INFO",
          "&7&m─────────────────",
          "&f● &7Player: &e{player_name}",
          "&f● &7Team: &b{ftb_team_display_name}",
          "&f● &7Role: &a{ftb_team_role}",
          "&f● &7Members: &e{ftb_team_members}",
          "",
          "&f● &7Rank: &a{ftb_rank_display_name}",
          "&f● &7Weight: &e{ftb_rank_weight}",
          "",
          "&f● &7Health: &c{player_health}&7/&c{player_max_health}",
          "&f● &7Food: &6{player_food}",
          "&f● &7Level: &a{player_level}",
          "&f● &7Ping: &e{player_ping}ms",
          "",
          "&f● &7Time: &f{time}",
          "&7&m─────────────────"
        ]
      },
      {
        "priority": 100,
        "conditionType": "placeholder",
        "condition": "ftb_has_rank:true",
        "lines": [
          "&7&m─────────────────",
          "&a&lRANK INFO",
          "&7&m─────────────────",
          "&f● &7Player: &e{player_name}",
          "&f● &7Rank: &a{ftb_rank_display_name}",
          "&f● &7Weight: &e{ftb_rank_weight}",
          "&f● &7Permissions: &e{ftb_rank_permissions}",
          "",
          "&f● &7Health: &c{player_health}&7/&c{player_max_health}",
          "&f● &7Food: &6{player_food}",
          "&f● &7Level: &a{player_level}",
          "",
          "&f● &7Location: &e{player_world}",
          "&f● &7X: &e{player_x} &7Z: &e{player_z}",
          "",
          "&f● &7Join a team for more features!",
          "&7&m─────────────────"
        ]
      },
      {
        "priority": 1,
        "conditionType": "default",
        "lines": [
          "&7&m─────────────────",
          "&e&lPLAYER INFO",
          "&7&m─────────────────",
          "&f● &7Player: &e{player_name}",
          "&f● &7Level: &a{player_level}",
