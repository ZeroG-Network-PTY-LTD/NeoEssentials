{
  "_comment": "Discord Integration Configuration for NeoEssentials",
  "_description": "Complete Discord integration with role synchronization and notifications",
  "_requirements": "Requires SimpleDiscordLink mod to be installed",
  "_roleIdInstructions": "Replace example role IDs with your actual Discord role IDs. See docs/DISCORD_ROLE_ID_SETUP.md",
  
  "discord": {
    "enabled": true,
    "integrationMode": "SimpleDiscordLink",
    "enableOnlyIfModInstalled": true,
    
    "messageFormatting": {
      "useEmbeds": true,
      "timestampFormat": "yyyy-MM-dd HH:mm:ss",
      "includePlayerStats": true,
      "includeTeamInfo": true,
      "includeRankInfo": true
    },
    
    "notifications": {
      "tablistUpdates": {
        "enabled": true,
        "channel": "general",
        "format": "🔄 **{player_name}** | Tablist updated | Team: **{ftb_team_display_name}** | Rank: **{ftb_rank_display_name}**"
      },
      "scoreboardUpdates": {
        "enabled": true,
        "channel": "general",
        "format": "📊 **{player_name}** | Scoreboard updated | Layout: **{layout_name}**"
      },
      "playerJoin": {
        "enabled": true,
        "channel": "general",
        "format": "✅ **{player_name}** joined! | Team: **{ftb_team_display_name}** | Rank: **{ftb_rank_display_name}** | Health: **{player_health}/{player_max_health}** ❤️"
      },
      "playerLeave": {
        "enabled": true,
        "channel": "general",
        "format": "❌ **{player_name}** left | Session: **{session_time}** | Team: **{ftb_team_display_name}**"
      },
      "teamUpdates": {
        "enabled": true,
        "channel": "general",
        "format": "👥 **{player_name}** | Team updated | Old: **{old_team}** → New: **{ftb_team_display_name}**",
        "requireFTBTeams": true
      },
      "rankUpdates": {
        "enabled": true,
        "channel": "general",
        "format": "🎖️ **{player_name}** | Rank updated | Old: **{old_rank}** → New: **{ftb_rank_display_name}**",
        "requireFTBRanks": true
      },
      "permissionChanges": {
        "enabled": true,
        "channel": "admin",
        "format": "🔐 **{player_name}** | Permission **{permission}** | Action: **{action}** | By: **{admin}**"
      },
      "achievements": {
        "enabled": true,
        "channel": "general",
        "format": "🏆 **{player_name}** earned **{achievement}**! | Team: **{ftb_team_display_name}**"
      }
    },
    
    "roleSync": {
      "enabled": true,
      "syncOnJoin": true,
      "syncInterval": 300,
      "bidirectional": true,
      "_comment": "IMPORTANT: Use actual Discord Role IDs (18-19 digits), not role names!",
      "_instructions": "Right-click Discord roles with Developer Mode enabled and copy ID",
      
      "roleMappings": {
        "123456789012345678": {
          "_roleName": "Server Owner",
          "_description": "Replace with your actual Owner role ID",
          "minecraftPermission": "neoessentials.admin",
          "priority": 1000,
          "tablistPrefix": "&4[OWNER]&r",
          "scoreboardTitle": "&4&lOWNER"
        },
        "234567890123456789": {
          "_roleName": "Administrator",
          "_description": "Replace with your actual Admin role ID",
          "minecraftPermission": "neoessentials.moderator",
          "priority": 800,
          "tablistPrefix": "&c[ADMIN]&r",
          "scoreboardTitle": "&c&lADMIN"
        },
        "345678901234567890": {
          "_roleName": "Moderator",
          "_description": "Replace with your actual Moderator role ID",
          "minecraftPermission": "neoessentials.helper",
          "priority": 600,
          "tablistPrefix": "&6[MOD]&r",
          "scoreboardTitle": "&6&lMODERATOR"
        },
        "456789012345678901": {
          "_roleName": "VIP Member",
          "_description": "Replace with your actual VIP role ID",
          "minecraftPermission": "neoessentials.vip",
          "priority": 400,
          "tablistPrefix": "&d[VIP]&r",
          "scoreboardTitle": "&d&lVIP"
        },
        "567890123456789012": {
          "_roleName": "Member",
          "_description": "Replace with your actual Member role ID",
          "minecraftPermission": "neoessentials.member",
          "priority": 200,
          "tablistPrefix": "&a[MEMBER]&r",
          "scoreboardTitle": "&a&lMEMBER"
        },
        "678901234567890123": {
          "_roleName": "Verified",
          "_description": "Replace with your actual Verified role ID",
          "minecraftPermission": "neoessentials.verified",
          "priority": 100,
          "tablistPrefix": "&7[VERIFIED]&r",
          "scoreboardTitle": "&7&lVERIFIED"
        }
      },
      
      "fallbackRole": {
        "minecraftPermission": "neoessentials.default",
        "priority": 0,
        "tablistPrefix": "&8[GUEST]&r",
        "scoreboardTitle": "&8&lGUEST"
      }
    },
    
    "chatSync": {
      "enabled": true,
      "includeTeamInfo": true,
      "includeRankInfo": true,
      "format": "**[{ftb_rank_display_name}]** {player_name}: {message}",
      "filterProfanity": true,
      "maxMessageLength": 2000,
      "fallbackFormat": "**{player_name}**: {message}"
    },
    
    "ftbIntegration": {
      "_comment": "FTB integration settings - only works if FTB Teams/Ranks mods are installed",
      "enableTeamIntegration": true,
      "enableRankIntegration": true,
      "fallbackIfNotInstalled": true,
      "syncTeamRoles": true,
      "syncRankPermissions": true,
      "enableFTBPlaceholders": true
    },
    
    "statusUpdates": {
      "enabled": true,
      "updateInterval": 60,
      "channel": "status",
      "embedStyle": {
        "color": "#00ff00",
        "title": "🎮 NeoEssentials Server Status",
        "fields": [
          {
            "name": "👥 Players Online",
            "value": "{players_online}/{max_players}",
            "inline": true
          },
          {
            "name": "🏆 Top Team",
            "value": "{top_team_name} ({top_team_members} members)",
            "inline": true,
            "requireFTBTeams": true
          },
          {
            "name": "⚡ Server Health",
            "value": "TPS: {server_tps} | RAM: {used_memory}/{max_memory}MB",
            "inline": false
          },
          {
            "name": "📊 Active Systems",
            "value": "Tablist: ✅ | Scoreboard: ✅ | Discord: ✅",
            "inline": false
          }
        ],
        "footer": "Last updated: {timestamp}",
        "thumbnail": "https://i.imgur.com/server-icon.png"
      }
    },
    
    "webhooks": {
      "enabled": true,
      "useWebhookForChat": true,
      "useWebhookForNotifications": true,
      "avatarPlaceholder": "https://minotar.net/helm/{player_name}/64.png",
      "defaultAvatar": "https://i.imgur.com/default-avatar.png"
    },
    
    "errorHandling": {
      "retryAttempts": 3,
      "retryDelay": 5000,
      "logErrors": true,
      "fallbackToBasicMessage": true,
      "gracefulDegradation": true
    },
    
    "compatibility": {
      "requireSimpleDiscordLink": true,
      "disableIfNotFound": true,
      "enableFallbackMode": true,
      "logMissingMods": true
    }
  }
}
