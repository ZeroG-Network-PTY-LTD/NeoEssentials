{
  "enableTablist": true,
  "tablistFormat": "[{group}] {player_name} | Ping: {ping}",
  "enableScoreboard": true,
  "scoreboardFormat": "Score: {score} | Player: {player_name}",
  "enableBossbar": true,
  "bossbarFormat": "Boss: {bossbar} | {message} [{progress}%]",
  "tablistLayouts": [
    {
      "priority": 100,
      "conditionType": "permission",
      "condition": "neoessentials.tablist.staff",
      "header": ["&6Staff | &e{player_name}"],
      "footer": ["&7Online: {online_count}"]
    },
    {
      "priority": 50,
      "conditionType": "permission",
      "condition": "neoessentials.tablist.vip",
      "header": ["&bVIP | &e{player_name}"],
      "footer": ["&7Enjoy your perks!"]
    },
    {
      "priority": 1,
      "conditionType": "default",
      "header": ["&fPlayer | &e{player_name}"],
      "footer": ["&7Welcome to the server!"]
    }
  ],
  "playerOrder": [
    { "placeholder": "group", "direction": "desc" },
    { "placeholder": "ping", "direction": "asc", "asNumber": true }
  ]
}
